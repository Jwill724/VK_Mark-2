#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

// Bloom upsample — 3x3 tent, additive accumulation.
// result(mip i) = downsampled(mip i) + tent(mip i+1)
// https://github.com/PanosK92/SpartanEngine/blob/master/data/shaders/bloom.hlsl

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D u_src;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, r11f_g11f_b10f) uniform image2D u_dst;

layout(push_constant) uniform BloomPush
{
	vec2  srcTexelSize;
	uvec2 dstRes;
	float filterRadius;
	uint  flags;
	float bloomThreshold;
	float bloomKnee;
} pc;

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (coord.x >= int(pc.dstRes.x) || coord.y >= int(pc.dstRes.y)) return;

	vec2 uv = (vec2(coord) + 0.5) / vec2(pc.dstRes);
	vec2 o  = pc.srcTexelSize * pc.filterRadius;

	// 9 bilinear taps in the SOURCE (coarser) mip:
	vec3 a = textureLod(u_src, uv + vec2(-o.x,  o.y), 0.0).rgb;
	vec3 b = textureLod(u_src, uv + vec2( 0.0,  o.y), 0.0).rgb;
	vec3 c = textureLod(u_src, uv + vec2( o.x,  o.y), 0.0).rgb;

	vec3 d = textureLod(u_src, uv + vec2(-o.x,  0.0), 0.0).rgb;
	vec3 e = textureLod(u_src, uv + vec2( 0.0,  0.0), 0.0).rgb;
	vec3 f = textureLod(u_src, uv + vec2( o.x,  0.0), 0.0).rgb;

	vec3 g = textureLod(u_src, uv + vec2(-o.x, -o.y), 0.0).rgb;
	vec3 h = textureLod(u_src, uv + vec2( 0.0, -o.y), 0.0).rgb;
	vec3 i = textureLod(u_src, uv + vec2( o.x, -o.y), 0.0).rgb;

	vec3 tent = e * 4.0
			  + (b + d + f + h) * 2.0
			  + (a + c + g + i) * 1.0;
	tent *= (1.0 / 16.0);

	vec3 base = imageLoad(u_dst, coord).rgb;   // this mip's downsampled energy
	imageStore(u_dst, coord, vec4(base + tent, 1.0));
}
