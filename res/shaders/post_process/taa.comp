#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/depth.glsl"

// =============================
// === TAA DESIGN REQUISITES ===
//
// 1. Exponential transparency fading on past frames to prevent ghosting and smearing. Frame N and Frame N-1 is just as opaque.
//    Frame N-2 should appear a third transparency or completely invisible (Both options are needed for those more or less bothered by blur or pixel crawl).
//
// 2. In order to make rule 1 visually stable, the temporal jitter pattern must be kept under 2 alternating positions that can sample thin
//    under sampled objects and specular highlights. Using positions showed in the 2017 Decima AA paper would be the best for this design.
//
// 3. Because of the limitations set by the first two rules, stair stepping needs to be addressed with SMAA only.
//    Use FXAA or even CMAA2 will not be sufficient enough or will cause blur.
//    SMAA is the only stair stepping elimination solution that doesn't harm the original clarity for a cheap cost.
// 
// 4. Accurate and high quality motion vectors need to be generated and combined with a high quality aggressive reprojection/pixel rejection algorithm.
//    We could derive from advanced reprojection solutions used in TSR or FSR3.1+.
//
// 5. Use the short array of past frames to create a 200% buffer that can be downscaled to the current resolution. This can be done with spatial interpolation
//    upscalers like FSR1 which already produce better results than AI and can be enhanced with accurate hints from SMAA edge detection and
//    temporal pixel correction(view DecimaSiggraph2017.pptx slide 50).
//
// 6. Always test the solution in complex motion that includes: Fast animations, fast camera movement, frequent disocclusion, and fast free flowing thin objects.
//    Always test at 1080p60fps on Blur Buster approved monitors with BFI or CRT/Plasma Screens and compare motions results with 4xSSAA. Not 8xSSAA or 8xMSAA.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inColorCurrent;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inColorHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D inVelocity;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D inVelocityHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D inDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform sampler2D inPrevDepth;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outColorResolved;

layout(push_constant) uniform TAAPush {
	float minBlend;
	float maxBlend;
	float depthDisocclusionScale;
} pc;

vec3 RGBToYCoCg(vec3 rgb)
{
	float co = rgb.r - rgb.b;
	float t = rgb.b + co * 0.5;
	float cg = rgb.g - t;
	float y = t + cg * 0.5;
	return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg)
{
	float t = ycocg.x - ycocg.z * 0.5;
	float g = ycocg.z + t;
	float b = t - ycocg.y * 0.5;
	float r = b + ycocg.y;
	return vec3(r, g, b);
}

vec3 sampleHistoryBilinear(vec2 uv)
{
	return RGBToYCoCg(texture(inColorHistory, uv).rgb);
}

vec2 getDilatedVelocity(vec2 uv, vec2 texelSize)
{
	float maxMag = 0.0;
	vec2 dilated = vec2(0.0);

	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			vec2 v = texture(inVelocity, uv + vec2(x, y) * texelSize).rg;
			float mag = dot(v, v);
			if (mag > maxMag) {
				maxMag  = mag;
				dilated = v;
			}
		}
	}

	return dilated;
}

float computeVelocityDisocclusion(vec2 uv, vec2 velocityUV)
{
	vec2 historyUV = uv - velocityUV;

	if (any(lessThan(historyUV, vec2(0.0))) || any(greaterThan(historyUV, vec2(1.0)))) return 1.0;

	vec2 prevVelocity = texture(inVelocityHistory, historyUV).rg;
	float velocityDelta = length(prevVelocity - velocityUV);
	return clamp((velocityDelta - 0.0002) * 50.0, 0.0, 1.0);
}

float computeDepthDisocclusion(vec2 uv, vec2 velocityUV)
{
	vec2 historyUV = uv - velocityUV;

	if (any(lessThan(historyUV, vec2(0.0))) || any(greaterThan(historyUV, vec2(1.0)))) return 1.0;

	float currentDepth = texelFetch(inDepth, ivec2(uv / vec2(scene.pixelSizes.xy)), 0).r;
	float prevDepth    = texture(inPrevDepth, historyUV).r;

	float depthDelta = currentDepth - prevDepth;

	return clamp(depthDelta * pc.depthDisocclusionScale, 0.0, 1.0);
}

vec3 varianceClip(vec3 historyYCoCg, vec2 uv, vec3 midM, float disocclusion)
{
	vec2 texelSize = vec2(scene.pixelSizes.xy);

	// Sample neighbourhood in RGB then convert — neighbourhood is jittered
	// but we anchor clip bounds to the unjittered center tap (midM) for chroma
	vec3 topL = RGBToYCoCg(texture(inColorCurrent, uv + vec2(-1, -1) * texelSize).rgb);
	vec3 topM = RGBToYCoCg(texture(inColorCurrent, uv + vec2( 0, -1) * texelSize).rgb);
	vec3 topR = RGBToYCoCg(texture(inColorCurrent, uv + vec2( 1, -1) * texelSize).rgb);
	vec3 midL = RGBToYCoCg(texture(inColorCurrent, uv + vec2(-1,  0) * texelSize).rgb);
	vec3 midR = RGBToYCoCg(texture(inColorCurrent, uv + vec2( 1,  0) * texelSize).rgb);
	vec3 botL = RGBToYCoCg(texture(inColorCurrent, uv + vec2(-1,  1) * texelSize).rgb);
	vec3 botM = RGBToYCoCg(texture(inColorCurrent, uv + vec2( 0,  1) * texelSize).rgb);
	vec3 botR = RGBToYCoCg(texture(inColorCurrent, uv + vec2( 1,  1) * texelSize).rgb);

	// 5-tap cross only for clip bounds — less noisy than full 3x3 on jittered input
	vec3 cMin5 = min(min(min(min(topM, midL), midM), midR), botM);
	vec3 cMax5 = max(max(max(max(topM, midL), midM), midR), botM);

	// 3x3 for variance/stddev — still useful for the statistical box
	const float totalSamples = 9.0;
	vec3 mean  = (topL + topM + topR + midL + midM + midR + botL + botM + botR) / totalSamples;
	vec3 sqSum = (topL*topL + topM*topM + topR*topR +
				  midL*midL + midM*midM + midR*midR +
				  botL*botL + botM*botM + botR*botR) / totalSamples;
	vec3 variance = sqSum - mean * mean;
	vec3 stddev   = sqrt(max(variance, vec3(0.0)));

	float stabilityBias = 1.0 - disocclusion;        // 1 = fully stable, 0 = disoccluded
	vec3 gamma = vec3(mix(2.0, 1.0, stabilityBias)); // wider box on stable pixels
	vec3 vMin = max(mean - gamma * stddev, cMin5);
	vec3 vMax = min(mean + gamma * stddev, cMax5);

	// Chroma extent anchored to the unjittered center tap (passed in as midM)
	// prevents chroma from chasing the jitter offset each frame
	vec2 chromaExtent = vec2(0.25 * 0.5 * (vMax.r - vMin.r));
	vMin.yz = midM.gb - chromaExtent;
	vMax.yz = midM.gb + chromaExtent;

	return clamp(historyYCoCg, vMin, vMax);
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

	SceneData scene   = getSceneData();
	const ivec2 res   = ivec2(scene.viewportSize.xy);

	if (pixel.x >= res.x || pixel.y >= res.y) return;

	const vec2 invRes = vec2(scene.pixelSizes.xy);
	const vec2 uv     = (vec2(pixel) + 0.5) * invRes;

	vec3 currentColor = texelFetch(inColorCurrent, pixel, 0).rgb;
	vec3 currentYCoCg = RGBToYCoCg(currentColor);

	vec2 velocityUV = getDilatedVelocity(uv, invRes);
	vec2 historyUV  = uv - velocityUV;

	bool validHistory = all(greaterThanEqual(historyUV, vec2(0.0))) &&
						all(lessThanEqual(historyUV, vec2(1.0)));

	if (!validHistory) {
		imageStore(outColorResolved, pixel, vec4(currentColor, 1.0));
		return;
	}

	float disocclusion = max(computeVelocityDisocclusion(uv, velocityUV),
							 computeDepthDisocclusion(uv, velocityUV));

	vec3 historyYCoCg = sampleHistoryBilinear(historyUV);
	historyYCoCg      = varianceClip(historyYCoCg, uv, currentYCoCg, disocclusion);

	float alpha = mix(pc.minBlend, pc.maxBlend, disocclusion);

	vec3 resolvedYCoCg = mix(historyYCoCg, currentYCoCg, alpha);
	vec3 resolvedRGB   = YCoCgToRGB(resolvedYCoCg);

	imageStore(outColorResolved, pixel, vec4(resolvedRGB, 1.0));
}
