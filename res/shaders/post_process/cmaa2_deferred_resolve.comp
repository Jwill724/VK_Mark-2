#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"
#include "../include/cmaa2.glsl"

// Original implementation: https://github.com/GameTechDev/CMAA2/blob/master/Projects/CMAA2/CMAA2/CMAA2.hlsl

layout(local_size_x = 32) in;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

layout(set = FRAME_SET, binding = ADDRESS_TABLE_BINDING, scalar) readonly buffer FrameAddressTableBuffer {
	GPUAddressTable frameAddressTable;
};

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D inTonemap;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_2_TEX) uniform usampler2D inWorkingEdges;
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D outColor;

uint quadIndexFromQuadPos(uvec2 quadPos, uint halfWidth)
{
	return quadPos.y * halfWidth + quadPos.x;
}

uint decodeOffsetXY(uint headValue)
{
	return (headValue >> CMAA2_HEAD_OFFSETXY_SHIFT) & CMAA2_HEAD_OFFSETXY_MASK;
}

uint decodeItemIndex(uint headValue)
{
	return headValue & CMAA2_HEAD_INDEX_MASK;
}

layout(push_constant) uniform CMAA2Push {
	uint halfWidth;
	uint maxShapeCandidates;
	uint maxDeferredItems;
	uint maxDeferredLocations;
} pc;

void main()
{
	Cmaa2ControlBuffer control =
		Cmaa2ControlBuffer(frameAddressTable.addrs[ABT_Cmaa2Control]);

	Cmaa2DeferredLocationsBuffer locations =
		Cmaa2DeferredLocationsBuffer(frameAddressTable.addrs[ABT_Cmaa2DeferredLocations]);

	Cmaa2DeferredHeadsBuffer heads =
		Cmaa2DeferredHeadsBuffer(frameAddressTable.addrs[ABT_Cmaa2DeferredHeads]);

	Cmaa2DeferredItemsBuffer items =
		Cmaa2DeferredItemsBuffer(frameAddressTable.addrs[ABT_Cmaa2DeferredItems]);

	uint locationCount = control.control[CMAA2_CTRL_DEFERRED_LOCATION_COUNT];
	if (locationCount > pc.maxDeferredLocations) {
		locationCount = pc.maxDeferredLocations;
	}

	uint locationIndex = gl_GlobalInvocationID.x;
	if (locationIndex >= locationCount) return;

	uint fullWidth = uint(scene.viewportSize.x);
	uint fullHeight = uint(scene.viewportSize.y);

	uint packedQuad = locations.quadIDs[locationIndex];

	uint quadX = packedQuad >> 16u;
	uint quadY = packedQuad & 0xFFFFu;

	uint quadCountX = pc.halfWidth;
	uint quadCountY = (fullHeight + 1u) >> 1u;

	if (quadX >= quadCountX || quadY >= quadCountY) return;

	uvec2 quadPos = uvec2(quadX, quadY);

	ivec2 basePixel = ivec2(quadPos << 1u);
	if (uint(basePixel.x) >= fullWidth || uint(basePixel.y) >= fullHeight) return;

	uint headIndex = quadIndexFromQuadPos(quadPos, pc.halfWidth);
	uint headValue = heads.heads[headIndex];

	// Nothing queued for this quad
	if (headValue == CMAA2_EMPTY_HEAD) return;

	for (uint offsetXY = 0u; offsetXY < 4u; offsetXY++)
	{
		ivec2 pixelPos = basePixel + pixelOffsets[offsetXY];
		if (uint(pixelPos.x) >= fullWidth || uint(pixelPos.y) >= fullHeight) continue;

		vec4 resolved = texelFetch(inTonemap, pixelPos, 0);

		uint walker = headValue;
		while (walker != CMAA2_EMPTY_HEAD)
		{
			uint nodeOffsetXY = decodeOffsetXY(walker);
			uint itemIndex = decodeItemIndex(walker);

			if (itemIndex >= pc.maxDeferredItems) break;

			uvec4 item = items.items[itemIndex];
			uint prevHead = item.x;

			if (nodeOffsetXY == offsetXY) {
				vec2 unpackedRG = unpackHalf2x16(item.y);
				vec2 unpackedBA = unpackHalf2x16(item.z);

				resolved = vec4(
					unpackedRG.x,
					unpackedRG.y,
					unpackedBA.x,
					unpackedBA.y
				);
				break;
			}

			walker = prevHead;
		}

		imageStore(outColor, pixelPos, resolved);
	}
}
