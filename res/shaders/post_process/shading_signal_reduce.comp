#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"

const int SHADING_TILE = 4;

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inShadingHalf;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outShadingLow;

void main()
{
	SceneData scene = getSceneData();

	ivec2 dst    = ivec2(gl_GlobalInvocationID.xy);
	ivec2 dstRes = imageSize(outShadingLow);
	if (any(greaterThanEqual(dst, dstRes))) return;

	ivec2 srcRes = (ivec2(scene.renderExtentSize.xy) + 1) / 2;
	ivec2 base   = dst * SHADING_TILE;

	vec2 sum = vec2(0.0);

	for (int y = 0; y < SHADING_TILE; ++y) {
		for (int x = 0; x < SHADING_TILE; ++x) {
			ivec2 t = min(base + ivec2(x, y), srcRes - 1);
			vec2  s = texelFetch(inShadingHalf, t, 0).rg;
			sum += (any(isnan(s)) || any(isinf(s))) ? vec2(0.0) : max(s, vec2(0.0));
		}
	}

	imageStore(outShadingLow, dst, vec4(sum / float(SHADING_TILE * SHADING_TILE), 0.0, 0.0));
}