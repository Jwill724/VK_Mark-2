#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"
#include "../include/pbr.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = GLOBAL_SET, binding = ADDRESS_TABLE_BINDING, scalar) buffer GlobalAddressTableBuffer {
	GPUAddressTable globalAddressTable;
};

layout(set = GLOBAL_SET, binding = GLOBAL_BINDING_DEBUG_INLINE, scalar) uniform DebugData {
	DebugToggles debug;
};

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D inOpaque;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_2_TEX) uniform sampler2D inTransparent;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_3_TEX) uniform sampler2D inVolumetricLight;

layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D outFlareBright;

layout(push_constant) uniform LensFlarePush {
	vec2 fullRes;
	vec2 invFullRes;

	vec2 outputRes;
	vec2 invOutputRes;

	vec2 sunUv;
	float sunVisible;
	uint rainbowLUTIndex;

	float brightThreshold;
	float brightKnee;
	float brightIntensity;
	float pad0;

	float ringInnerRadius;
	float ringOuterRadius;
	float chromaStrength;
	float pad1;

	float streakStrength;
	float streakWidth;
	float streakLength;
	float pad2;

	float occlusionRadiusPixels;
	float occlusionDepthBias;
	float occlusionFade;
	float pad3;
} pc;

// Simple soft-knee threshold (bloom-style).
// threshold = start, knee = softness range.
float softThreshold(float value, float threshold, float knee);


void main()
{
	ivec2 outDim = imageSize(outFlareBright);
	ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(outCoord, outDim))) return;

	if (pc.sunVisible < 0.5) {
		imageStore(outFlareBright, outCoord, vec4(0.0));
		return;
	}

	vec2 uv = (vec2(outCoord) + 0.5) / vec2(outDim);

	ivec2 fullCoord = ivec2(uv * pc.fullRes);
	fullCoord = clamp(fullCoord, ivec2(0), ivec2(pc.fullRes) - ivec2(1));

	vec3 hdrOpaque = texelFetch(inOpaque, fullCoord, 0).rgb;
	vec3 hdrTransparent = texelFetch(inTransparent, fullCoord, 0).rgb;

	vec3 hdrScene = hdrOpaque + hdrTransparent;

	vec3 volumetricLight = texture(inVolumetricLight, uv).rgb;
	hdrScene += volumetricLight;

	float exposure = LuminanceBuffer(globalAddressTable.addrs[ABT_Luminance]).luminanceSums[0].x;
	exposure = max(exposure, 1e-4);

	float thresholdHdr = pc.brightThreshold / exposure;
	float kneeHdr = pc.brightKnee / exposure;

	// Brightness measure + soft threshold
	float sceneLum = luminance(hdrScene);
	float amount = softThreshold(sceneLum, thresholdHdr, kneeHdr);

	// Using scene color preserves tinting, normalize avoids blowing out on huge HDR.
	vec3 brightColor = vec3(0.0);
	if (amount > 0.0) {
		float invLum = 1.0 / max(sceneLum, 1e-6);
		brightColor = hdrScene * (amount * invLum);
	}

	brightColor *= pc.brightIntensity;

	imageStore(outFlareBright, outCoord, vec4(brightColor, 1.0));
}

float softThreshold(float value, float threshold, float knee)
{
	float kneeMin = threshold - knee;
	float kneeMax = threshold + knee;

	if (value <= kneeMin) return 0.0;

	if (value >= kneeMax) return value - threshold;

	// Smooth in-between
	float t = (value - kneeMin) / max(kneeMax - kneeMin, 1e-6);
	t = t * t * (3.0 - 2.0 * t);

	float soft = (value - threshold) * t;
	return max(soft, 0.0);
}
