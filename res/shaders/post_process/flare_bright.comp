#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/pbr.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inSceneHDR;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inVolumetricLight;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outFlareBright;

layout(push_constant) uniform LensFlarePush {
	vec2 outputRes;
	vec2 invOutputRes;

	vec2 sunUv;
	float sunVisible;
	uint rainbowLUTIndex;

	float brightThreshold;
	float brightKnee;
	float brightIntensity;
	float pad0;

	float ringInnerRadius;
	float ringOuterRadius;
	float chromaStrength;
	float pad1;

	float streakStrength;
	float streakWidth;
	float streakLength;
	float pad2;

	float occlusionRadiusPixels;
	float occlusionDepthBias;
	float occlusionFade;
	float pad3;
} pc;

void main()
{
	ivec2 outDim = imageSize(outFlareBright);
	ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(outCoord, outDim))) return;

	if (pc.sunVisible < 0.5) {
		imageStore(outFlareBright, outCoord, vec4(0.0));
		return;
	}

	vec2 uv = (vec2(outCoord) + 0.5) / vec2(outDim);

	SceneData scene = getSceneData();
	vec2 fullRes = vec2(scene.viewportSize.xy);

	ivec2 fullCoord = ivec2(uv * fullRes);
	fullCoord = clamp(fullCoord, ivec2(0), ivec2(fullRes) - ivec2(1));

	vec3 hdrScene = texelFetch(inSceneHDR, fullCoord, 0).rgb;

	vec3 volumetricLight = texture(inVolumetricLight, uv).rgb;
	hdrScene += volumetricLight;

	float exposure = getLuminanceBuffer().luminanceSums[0].x;
	exposure = max(exposure, 1e-4);

	float thresholdHdr = pc.brightThreshold / exposure;
	float kneeHdr = pc.brightKnee / exposure;

	// Brightness measure + soft threshold
	float sceneLum = luminance(hdrScene);
	float amount = softThreshold(sceneLum, thresholdHdr, kneeHdr);

	// Using scene color preserves tinting, normalize avoids blowing out on huge HDR.
	vec3 brightColor = vec3(0.0);
	if (amount > 0.0) {
		float invLum = 1.0 / max(sceneLum, 1e-6);
		brightColor = hdrScene * (amount * invLum);
	}

	brightColor *= pc.brightIntensity;

	imageStore(outFlareBright, outCoord, vec4(brightColor, 1.0));
}
