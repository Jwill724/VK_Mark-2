#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

// Based on implementation
// https://github.com/PanosK92/SpartanEngine/blob/master/data/shaders/bloom.hlsl

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D u_src;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D u_depth;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D u_dst;

#define BLOOM_FIRST_DOWNSAMPLE_BIT 1u

layout(push_constant) uniform BloomPush
{
	vec2  srcTexelSize;
	uvec2 dstRes;
	float filterRadius;
	uint  flags;           // 0 = first downsample
	float bloomThreshold;
	float bloomKnee;
} pc;

vec3 KarisAverage(vec3 c0, vec3 c1, vec3 c2, vec3 c3)
{
	float w0 = KarisWeight(c0);
	float w1 = KarisWeight(c1);
	float w2 = KarisWeight(c2);
	float w3 = KarisWeight(c3);
	return (c0 * w0 + c1 * w1 + c2 * w2 + c3 * w3) / max(w0 + w1 + w2 + w3, 1e-5);
}

float SkyMask(vec2 uv)
{
	float depth = textureLod(u_depth, uv, 0.0).r;
	// far plane == 0; fade in just off the plane to soften the horizon seam
	return smoothstep(0.0, 1e-4, depth);
}

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (coord.x >= int(pc.dstRes.x) || coord.y >= int(pc.dstRes.y)) return;

	vec2 uv = (vec2(coord) + 0.5) / vec2(pc.dstRes);
	vec2 t  = pc.srcTexelSize;

	// 13 bilinear taps
	vec3 a = textureLod(u_src, uv + vec2(-2.0 * t.x,  2.0 * t.y), 0.0).rgb;
	vec3 b = textureLod(u_src, uv + vec2( 0.0,        2.0 * t.y), 0.0).rgb;
	vec3 c = textureLod(u_src, uv + vec2( 2.0 * t.x,  2.0 * t.y), 0.0).rgb;

	vec3 d = textureLod(u_src, uv + vec2(-2.0 * t.x,  0.0), 0.0).rgb;
	vec3 e = textureLod(u_src, uv + vec2( 0.0,        0.0), 0.0).rgb;
	vec3 f = textureLod(u_src, uv + vec2( 2.0 * t.x,  0.0), 0.0).rgb;

	vec3 g = textureLod(u_src, uv + vec2(-2.0 * t.x, -2.0 * t.y), 0.0).rgb;
	vec3 h = textureLod(u_src, uv + vec2( 0.0,       -2.0 * t.y), 0.0).rgb;
	vec3 i = textureLod(u_src, uv + vec2( 2.0 * t.x, -2.0 * t.y), 0.0).rgb;

	vec3 j = textureLod(u_src, uv + vec2(-t.x,      t.y), 0.0).rgb;
	vec3 k = textureLod(u_src, uv + vec2( t.x,      t.y), 0.0).rgb;
	vec3 l = textureLod(u_src, uv + vec2(-t.x,     -t.y), 0.0).rgb;
	vec3 m = textureLod(u_src, uv + vec2( t.x,     -t.y), 0.0).rgb;

	vec3 result;
	if ((pc.flags & BLOOM_FIRST_DOWNSAMPLE_BIT) != 0u)
	{
		// Per-box Karis (5 overlapping 2x2 boxes), then structural combine.
		vec3 box0 = KarisAverage(a, b, d, e);
		vec3 box1 = KarisAverage(b, c, e, f);
		vec3 box2 = KarisAverage(d, e, g, h);
		vec3 box3 = KarisAverage(e, f, h, i);
		vec3 box4 = KarisAverage(j, k, l, m);
		result = box4 * 0.5 + (box0 + box1 + box2 + box3) * 0.125;

		result *= SkyMask(uv);

		float exposure     = getLuminanceBuffer().luminanceSums[0].x;
		float thresholdHdr = pc.bloomThreshold / exposure;
		float kneeHdr      = pc.bloomKnee      / exposure;
		float lum          = luminance(result);
		float amount       = softThreshold(lum, thresholdHdr, kneeHdr);
		result             = (amount > 0.0) ? result * (amount / max(lum, 1e-6)) : vec3(0.0);
	}
	else
	{
		// Standard COD weights (sum = 1).
		result  = e * 0.125;
		result += (a + c + g + i) * 0.03125;
		result += (b + d + f + h) * 0.0625;
		result += (j + k + l + m) * 0.125;
	}

	imageStore(u_dst, coord, vec4(max(result, vec3(0.0)), 1.0));
}
