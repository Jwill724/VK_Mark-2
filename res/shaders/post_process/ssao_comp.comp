#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

// Sample kernel
const int KERNEL_SIZE = 128;
layout(set = GLOBAL_SET, binding = GLOBAL_BINDING_SSAO_KERNEL) uniform KernelUBO {
	vec4 samples[KERNEL_SIZE]; // pre-generated hemisphere samples
} kernel;

layout(push_constant) uniform SSAOPush {
	mat4 invProj;
	vec2 screenSize;
	vec2 invScreenSize;
	float aoRadius;
	float bias;
	float intensity;
	int blurRadius;
	uint sampleCount;
	float pad0[3];
} pc;

// Depth texture
layout(set = PUSH_SET, binding = PUSH_BINDING_DEPTH_TEX) uniform sampler2D depthTex;

// Normal texture
layout(set = PUSH_SET, binding = PUSH_BINDING_NORMAL_TEX) uniform sampler2D normalTex;

// Noise texture
layout(set = PUSH_SET, binding = PUSH_BINDING_NOISE_TEX) uniform sampler2D noiseTex;

// SSAO output (R8_UNORM)
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_TEX, r8) uniform writeonly image2D ssaoOut;

vec3 reconstructViewPos(vec2 uv, float depth) {
	// clip space position vulkan [0,1](NDC)
	vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
	vec4 view = pc.invProj * clip;
	vec3 pos = view.xyz / view.w;
	return pos;
}

// Basically just opengl tutorial ssao implementation
void main() {
	ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	if (pix.x >= int(pc.screenSize.x) || pix.y >= int(pc.screenSize.y)) return;

	vec2 uv = (vec2(pix) + 0.5) * pc.invScreenSize;

	// Depth + normal at this pixel
	float depth = texture(depthTex, uv).r;
	if (depth >= 1.0) {
		imageStore(ssaoOut, pix, vec4(1.0)); // far plane -> no occlusion
		return;
	}

	vec3 pos = reconstructViewPos(uv, depth);
	vec3 normal = normalize(texture(normalTex, uv).xyz * 2.0 - 1.0);

	// Noise rotation (tangent space basis)
	vec3 randomVec = normalize(texture(noiseTex, uv * (pc.screenSize / 4.0)).xyz);
	vec3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
	vec3 bitangent = cross(normal, tangent);
	mat3 TBN = mat3(tangent, bitangent, normal);

	float radius = pc.aoRadius;
	float occlusion = 0.0;
	for (int i = 0; i < pc.sampleCount; ++i) {
		vec3 samplePos = pos + (TBN * kernel.samples[i].xyz) * radius;

		// project from view -> clip -> uv
		vec4 clip = scene.proj * vec4(samplePos, 1.0);
		vec2 sampleUV = clip.xy / clip.w * 0.5 + 0.5;

		if (sampleUV.x < 0.0 || sampleUV.x > 1.0 ||
			sampleUV.y < 0.0 || sampleUV.y > 1.0)
			continue;

		float sampleDepth = texture(depthTex, sampleUV).r;
		vec3 sampleViewPos = reconstructViewPos(sampleUV, sampleDepth);

		float rangeCheck = smoothstep(0.0, 1.0, radius / abs(pos.z - sampleViewPos.z));
		occlusion += (sampleViewPos.z >= samplePos.z + pc.bias ? 1.0 : 0.0) * rangeCheck;
	}

	occlusion = 1.0 - (occlusion / pc.sampleCount);
	occlusion *= pc.intensity;

	imageStore(ssaoOut, pix, vec4(occlusion, 0.0, 0.0, 1.0));
}