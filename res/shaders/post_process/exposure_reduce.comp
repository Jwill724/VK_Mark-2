#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

// Amazing resource on why exposure is important
// https://bruop.github.io/exposure/

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D hdrScene;

shared float localLuminance[gl_WorkGroupSize.x * gl_WorkGroupSize.y];

void main()
{
	ivec2 size = textureSize(hdrScene, 0);
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

	if (coord.x >= size.x || coord.y >= size.y) return;

	vec3 hdr = texelFetch(hdrScene, coord, 0).rgb;
	float Y = luminance(hdr);
	float logY = log(Y);

	uint lid = gl_LocalInvocationIndex;
	localLuminance[lid] = logY;
	barrier();

	for (uint stride = (gl_WorkGroupSize.x * gl_WorkGroupSize.y) >> 1; stride > 0; stride >>= 1) {
		if (lid < stride)
			localLuminance[lid] += localLuminance[lid + stride];
		barrier();
	}

	if (lid == 0) {
		uint groupIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;

		LuminanceBuffer lBuf = getLuminanceBuffer();
		lBuf.luminanceSums[groupIndex] = vec4(localLuminance[0], 0.0, 0.0, 0.0);
	}
}
