#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"

layout(local_size_x = 256) in;

layout(set = GLOBAL_SET, binding = ADDRESS_TABLE_BINDING, scalar) buffer GlobalAddressTableBuffer {
	GPUAddressTable globalAddressTable;
};

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

// Samplers not in use here but binding is defined within this context
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D opaqueImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_2_TEX) uniform sampler2D transparentImage;

layout(push_constant) uniform ExposurePush {
	uint totalTiles;
	uint pad0[3];
} push;

shared float sharedSum[256];

void main()
{
	LuminanceBuffer lBuf = LuminanceBuffer(globalAddressTable.addrs[ABT_Luminance]);

	uint gid = gl_GlobalInvocationID.x;
	uint lid = gl_LocalInvocationIndex;

	float value = 0.0;
	if (gid < push.totalTiles) {
		value = lBuf.luminanceSums[gid].x;
	}

	sharedSum[lid] = value;
	barrier();

	for (uint stride = gl_WorkGroupSize.x >> 1; stride > 0; stride >>= 1) {
		if (lid < stride) {
			sharedSum[lid] += sharedSum[lid + stride];
		}
		barrier();
	}

	// The first thread of the last workgroup does the final total + exposure
	if (gl_WorkGroupID.x == gl_NumWorkGroups.x - 1 && lid == 0) {
		float totalLog = 0.0;

		// Accumulate all previous group results
		for (uint i = 0; i < gl_NumWorkGroups.x - 1; ++i) {
			totalLog += lBuf.luminanceSums[i].x;
		}

		totalLog += sharedSum[0];

		uint pixelCount = max(uint(scene.viewportSize.z), 1u);

		float Lavg = exp(totalLog / float(pixelCount));
		Lavg = clamp(Lavg, 0.001, 100.0);

		float exposure = 0.18 / Lavg;

		lBuf.luminanceSums[0] = vec4(exposure, 0.0, 0.0, 0.0);
	}
}