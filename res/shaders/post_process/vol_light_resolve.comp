#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inVolumetricLight;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D inHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D inPrevDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outResolvedVolumetric;

layout(push_constant) uniform VolumetricPush
{
	float density;
	float scatteringStrength;
	float extinction;
	float heightFalloff;

	float maxDistance;
	float jitterStrength;
	float asymmetryFactor;
	float minTransmittance;

	int   beamPower;

	float blurRadius;
	float blurDepthSigma;
	float blurWeightSigma;

	vec2  blurDirection;

	float historyWeight;
	float clipGamma;
} pc;

void main()
{
	ivec2 pixelCoord  = ivec2(gl_GlobalInvocationID.xy);
	ivec2 halfResSize = imageSize(outResolvedVolumetric);

	if (any(greaterThanEqual(pixelCoord, halfResSize))) return;

	SceneData scene = getSceneData();

	vec4 current = texelFetch(inVolumetricLight, pixelCoord, 0);

	if (scene.temporal.y == 0u) {
		imageStore(outResolvedVolumetric, pixelCoord, current);
		return;
	}

	vec3 moment1 = vec3(0.0);
	vec3 moment2 = vec3(0.0);

	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			ivec2 tap = clamp(pixelCoord + ivec2(x, y), ivec2(0), halfResSize - 1);
			vec3  c   = texelFetch(inVolumetricLight, tap, 0).rgb;
			moment1 += c;
			moment2 += c * c;
		}
	}

	vec3 mean   = moment1 / 9.0;
	vec3 sigma  = sqrt(max(moment2 / 9.0 - mean * mean, vec3(0.0)));
	vec3 boxMin = min(mean - pc.clipGamma * sigma, current.rgb);
	vec3 boxMax = max(mean + pc.clipGamma * sigma, current.rgb);

	vec2 halfPixelSize = scene.renderPixelSizes.zw;
	vec2 uv            = (vec2(pixelCoord) + 0.5) * halfPixelSize;

	vec3 viewRayVS   = cheapReconstructViewPos(uv, 1.0, scene.ndcToViewMult, scene.ndcToViewAdd);
	vec3 viewDirWS   = normalize(mat3(scene.invView) * viewRayVS);
	vec3 anchorWorld = scene.cameraPos.xyz + viewDirWS * current.a;

	vec4 prevClip = scene.prevViewProjUnjittered * vec4(anchorWorld, 1.0);
	if (prevClip.w <= 1e-6) {
		imageStore(outResolvedVolumetric, pixelCoord, current);
		return;
	}

	vec2 prevUv = GetPrevUV(prevClip);

	if (any(lessThan(prevUv, vec2(0.0))) || any(greaterThan(prevUv, vec2(1.0)))) {
		imageStore(outResolvedVolumetric, pixelCoord, current);
		return;
	}

	float blend      = pc.historyWeight;
	vec4  depthQuad  = textureGather(inDepth, uv, 0);
	float depthValue = max(max(depthQuad.x, depthQuad.y), max(depthQuad.z, depthQuad.w));
	if (depthValue >= DEPTH_EPSILON_REVERSED_Z) {
		float surfaceViewDepth = screenToViewDepth(depthValue, scene.depthLinearizeMult, scene.depthLinearizeAdd);
		vec3  surfaceVS        = cheapReconstructViewPos(uv, surfaceViewDepth, scene.ndcToViewMult, scene.ndcToViewAdd);
		vec4  surfaceClip      = scene.prevViewProjUnjittered * (scene.invView * vec4(surfaceVS, 1.0));

		float sampledViewDepth = screenToViewDepth(texture(inPrevDepth, prevUv).r, scene.depthLinearizeMult, scene.depthLinearizeAdd);

		if (abs(surfaceClip.w - sampledViewDepth) > 0.05 * surfaceClip.w) blend = 0.0;
	}

	vec3 history  = texture(inHistory, prevUv).rgb;
	vec3 clamped  = clamp(history, boxMin, boxMax);
	vec3 resolved = mix(current.rgb, clamped, blend);

	imageStore(outResolvedVolumetric, pixelCoord, vec4(resolved, current.a));
}
