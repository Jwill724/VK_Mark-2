#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"
#include "../include/shadow.glsl"
#include "../include/depth.glsl"

// Good resources to understand how volumetric lights work
// https://www.scratchapixel.com/lessons/3d-basic-rendering/volume-rendering-for-developers/ray-marching-get-it-right.html
// https://www.gamedeveloper.com/programming/atmospheric-scattering-and-volumetric-fog-algorithm-part-1#close-modal
// https://www.youtube.com/watch?v=G0sYTrX3VHI

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

layout(set = FRAME_SET, binding = FRAME_BINDING_CSM) uniform ShadowUBO {
	ShadowCSM csm;
};

layout(set = GLOBAL_SET, binding = GLOBAL_BINDING_DEBUG_INLINE, scalar) uniform DebugData {
	DebugToggles debug;
};

layout(set = GLOBAL_SET, binding = GLOBAL_BINDING_COMBINED_SAMPLER) uniform sampler2D combinedSamplers[];

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D inDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D outVolumetricLight;

layout(push_constant) uniform VolumetricPush
{
	float density;             // overall fog density
	float scatteringStrength;  // brightness of scattered light
	float extinction;          // how fast light is absorbed
	float heightFalloff;       // vertical fog falloff

	float maxDistance;         // max ray length in world/view units
	float jitterStrength;      // scales step jitter for banding hiding
	int stepCount;             // march steps
	float pad0;

	float asymmetryFactor;     // phase function asymmetry factor (g)
	float minTransmittance;    // minimum remaining light before fully attenuated
	vec2 pixelSize;            // 1.0 / halfResExtent (x,y)

	int beamPower;             // Determines how tight or wide beams are
	// Blur (shared by X/Y passes)
	float blurRadius;          // kernel radius in half-res pixels
	float blurDepthSigma;      // depth sensitivity for bilateral blur
	float blurWeightSigma;     // Gaussian width

	vec2 blurDirection;        // (1,0) for horizontal, (0,1) for vertical
} pc;

vec3 worldToShadowUvz(vec3 worldPos, uint cascadeIdx, out bool valid)
{
	vec4 lightClip = csm.cascadeVP[cascadeIdx] * vec4(worldPos, 1.0);
	vec3 projCoords = lightClip.xyz / lightClip.w;

	vec2 uv;
	uv = projCoords.xy * 0.5 + 0.5;
	uv.y = 1.0 - uv.y;

	float z = projCoords.z;

	valid = !(uv.x < 0.0 || uv.x > 1.0 ||
			  uv.y < 0.0 || uv.y > 1.0 ||
			  z    < 0.0 || z    > 1.0);

	return vec3(uv, z);
}

float sampleShadowVolumetric(ViewReconstructResult result, uint cascadeIdx, mat2 poissonRotation)
{
	vec3 worldPos = result.pos;

	bool valid = false;
	vec3 uvz = worldToShadowUvz(worldPos, cascadeIdx, valid);
	if (!valid) return 1.0;

	const uint shadowMapID = uint(csm.params.y);
	const float bias = csm.params.x;
	const float texel = csm.params.w;

	vec4 atlas = csm.atlasUV[cascadeIdx];
	vec2 atlasUV = uvz.xy * atlas.xy + atlas.zw;

	float shadow = PCFPoissonLow(
		poissonRotation,
		combinedSamplers[nonuniformEXT(shadowMapID)],
		atlasUV,
		uvz.z,
		bias,
		texel);

	return shadow;
}

float sampleJitter(ivec2 pixelCoord)
{
	float noiseValue = interleavedGradientNoise(vec2(pixelCoord));
	return noiseValue - 0.5;
}

float phaseHenyeyGreenstein(float cosTheta, float g)
{
	float g2 = g * g;
	float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 0.0001);
	return 1.0 / (4.0 * 3.14159265359) * (1.0 - g2) / (denom * sqrt(denom));
}

void main()
{
	ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 halfResSize = imageSize(outVolumetricLight);

	if (any(greaterThanEqual(pixelCoord, halfResSize))) return;

	// Shadow map rotation hash
	mat2 poissonRotation = createHash(vec2(pixelCoord));

	// Half-res UV
	vec2 uv = (vec2(pixelCoord) + 0.5) * pc.pixelSize;
	vec2 samplingUV = uv;

	if (debug.aaMode == AA_TAA) {
		// Remove jitter from UV before depth sample to get stable world position reconstruction
		samplingUV -= scene.temporalJitter.xy * 0.5; // NDC to UV space
		samplingUV = clamp(samplingUV, vec2(0.0), vec2(1.0));
	}

	vec4 depths = textureGather(inDepth, samplingUV, 0);
	float depthValue = texture(inDepth, samplingUV).r;

	ViewReconstructResult reconstructPos;
	reconstructPos = reconstructWorldPosFromDepth(samplingUV, depthValue, scene.invProj, scene.invView);

	vec3 cameraWorldPos = scene.cameraPos.xyz;
	vec3 viewRay = reconstructPos.pos - cameraWorldPos;

	// Camera direction
	vec3 viewDir = normalize(viewRay);

	// Sun data
	vec3 sunDir = normalize(scene.sunlightDirection.xyz);

	// Angle between camera view and incoming sunlight
	float cosTheta = dot(viewDir, sunDir);
	// If sun is mostly behind camera
	if (cosTheta < -0.1) {
		imageStore(outVolumetricLight, pixelCoord, vec4(0.0));
		return;
	}

	vec3 sunColor = scene.sunlightColor.rgb * scene.sunlightColor.a;

	// Only march until geometry is hit
	float distanceToSurface = length(viewRay);
	float maxRayDistance = pc.maxDistance;
	bool hasHitGeometry = depthValue >= DEPTH_EPSILON_REVERSED_Z;
	if (hasHitGeometry) {
		maxRayDistance = min(maxRayDistance, distanceToSurface);
	}

	if (maxRayDistance <= 0.0 || pc.stepCount <= 0) {
		imageStore(outVolumetricLight, pixelCoord, vec4(0.0));
		return;
	}

	float dirMask = pow(clamp(cosTheta, 0.0, 1.0), float(pc.beamPower));

	// Phase function
	float phase = phaseHenyeyGreenstein(cosTheta, pc.asymmetryFactor);

	// Jitter the starting position along the ray to reduce banding
	float stepLength = maxRayDistance / float(pc.stepCount);
	float jitter = sampleJitter(pixelCoord) * pc.jitterStrength * stepLength;
	float rayT = max(jitter, 0.0);

	vec3 accumulatedLight = vec3(0.0);
	float transmittance = 1.0;

	float localDensity = pc.density;

	// Extinction
	float extinctionCoeff = localDensity * pc.extinction;
	float segmentTrans = exp(-extinctionCoeff * stepLength);

	vec3 baseScatter = sunColor * localDensity * phase * dirMask * pc.scatteringStrength;

	const uint cascadeCount = uint(csm.params.z);
	uint cascadeIdx = cascadeViewDepthSplit(reconstructPos.viewDepth, cascadeCount, csm.cascadeSplits);
	float nextSplit = csm.cascadeSplits[min(cascadeIdx, cascadeCount - 1u)];

	vec3 camForward = -vec3(scene.invView[0][2], scene.invView[1][2], scene.invView[2][2]);
	float forwardDot = dot(camForward, viewDir);

	// Height factor
	float heightStart = max(cameraWorldPos.y, 0.0);
	float heightFactor = exp(-pc.heightFalloff * heightStart);
	float heightStep = exp(-pc.heightFalloff * viewDir.y * stepLength);

	for (int i = 0; i < pc.stepCount; ++i) {
		if (rayT > maxRayDistance) break;

		vec3 samplePos = cameraWorldPos + viewDir * rayT;
		reconstructPos.pos = samplePos;
		reconstructPos.viewDepth = dot(camForward, cameraWorldPos) + forwardDot * rayT;

		// Only re-check cascade when approaching the next split
		if (reconstructPos.viewDepth > nextSplit) {
			cascadeIdx = cascadeViewDepthSplit(reconstructPos.viewDepth, cascadeCount, csm.cascadeSplits);
			nextSplit = (cascadeIdx < cascadeCount - 1u)
				? csm.cascadeSplits[cascadeIdx + 1u]
				: 1e30;
		}

		// Sample CSM shadowing
		float shadowTerm = sampleShadowVolumetric(reconstructPos, cascadeIdx, poissonRotation);

		accumulatedLight += baseScatter * heightFactor * shadowTerm * transmittance * stepLength;
		transmittance *= segmentTrans;
		heightFactor *= heightStep;

		if (transmittance < pc.minTransmittance) break;

		rayT += stepLength;
	}

	imageStore(outVolumetricLight, pixelCoord, vec4(accumulatedLight, 1.0));
}
