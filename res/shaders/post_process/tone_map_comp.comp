#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = GLOBAL_SET, binding = ADDRESS_TABLE_BINDING, scalar) readonly buffer GlobalAddressTableBuffer {
	GPUAddressTable globalAddressTable;
};

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

layout(set = GLOBAL_SET, binding = GLOBAL_BINDING_DEBUG_INLINE, scalar) uniform DebugData {
	DebugToggles debug;
};

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D opaqueImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_2_TEX) uniform sampler2D transparentImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_3_TEX) uniform sampler2D volumetricLightImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_4_TEX) uniform sampler2D lensFlareColorImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D toneMapImage;

vec3 ACESFilm(vec3 x) {
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	return clamp((x * (a * x + b)) / (x *(c * x + d) + e), 0.0, 1.0);
}

float noiseHash(ivec2 p)
{
	return fract(sin(dot(vec2(p), vec2(12.9898, 78.233))) * 43758.5453);
}

void main()
{
	ivec2 dim = imageSize(toneMapImage);
	ivec2 pid = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pid, dim))) return;

	vec2 uvFull = (vec2(pid) + 0.5) / vec2(dim);

	vec3 hdrOpaque = texelFetch(opaqueImage, pid, 0).rgb;
	vec3 hdrTransparent = texelFetch(transparentImage, pid, 0).rgb;
	vec3 hdrScene = hdrOpaque + hdrTransparent;

	vec3 volumetricLight = texture(volumetricLightImage, uvFull).rgb;

	vec3 lensFlare = vec3(0.0);
	if (DBG(enableLensFlare)) {
		ivec2 flareDim = textureSize(lensFlareColorImage, 0);
		vec2 uvFlare = (uvFull * vec2(flareDim) + 0.5) / vec2(flareDim);
		lensFlare = textureLod(lensFlareColorImage, uvFlare, 0.0).rgb;
	}

	if (DBG(enableChromaticAberration)) {
		// Radial direction from screen center
		vec2 centeredUv = uvFull * 2.0 - 1.0;

		float centeredLen = length(centeredUv);

		vec2 radialDir = vec2(0.0);
		if (centeredLen > 1e-6) {
			radialDir = centeredUv / centeredLen;
		}

		// Strength curve
		float t = clamp(centeredLen, 0.0, 1.0);
		const float maxShiftPixels = 2.0;
		float desiredShiftPixels = t * t * t * maxShiftPixels;

		vec2 invDim = 1.0 / vec2(dim);

		// Clamp UVs to half texel to avoid sampling outside
		vec2 halfTexel = 0.5 * invDim;
		vec2 uvMin = halfTexel;
		vec2 uvMax = vec2(1.0) - halfTexel;

		// Compute how much shift is safe before we would hit the border
		// (separately for +dir and -dir, then take the min)
		vec2 distToMin = uvFull - uvMin;
		vec2 distToMax = uvMax - uvFull;

		vec2 dirPos = max(radialDir, vec2(0.0));
		vec2 dirNeg = max(-radialDir, vec2(0.0));

		float maxShiftUvPos = 1e9;
		if (dirPos.x > 1e-6) maxShiftUvPos = min(maxShiftUvPos, distToMax.x / dirPos.x);
		if (dirPos.y > 1e-6) maxShiftUvPos = min(maxShiftUvPos, distToMax.y / dirPos.y);

		float maxShiftUvNeg = 1e9;
		if (dirNeg.x > 1e-6) maxShiftUvNeg = min(maxShiftUvNeg, distToMin.x / dirNeg.x);
		if (dirNeg.y > 1e-6) maxShiftUvNeg = min(maxShiftUvNeg, distToMin.y / dirNeg.y);

		float maxShiftUvSafe = min(maxShiftUvPos, maxShiftUvNeg);

		float desiredShiftUv = desiredShiftPixels * invDim.x;
		float safeScale = 1.0;
		if (desiredShiftUv > 1e-8) {
			safeScale = clamp(maxShiftUvSafe / desiredShiftUv, 0.0, 1.0);
		}
		float edgeFade = smoothstep(0.0, 0.02, min(min(distToMin.x, distToMin.y), min(distToMax.x, distToMax.y)));
		safeScale *= edgeFade;

		vec2 shiftUv = radialDir * desiredShiftPixels * invDim * safeScale;

		vec2 uvR = clamp(uvFull + shiftUv, uvMin, uvMax);
		vec2 uvG = clamp(uvFull, uvMin, uvMax);
		vec2 uvB = clamp(uvFull - shiftUv, uvMin, uvMax);

		vec3 sceneR =
			textureLod(opaqueImage, uvR, 0.0).rgb +
			textureLod(transparentImage, uvR, 0.0).rgb;

		vec3 sceneG =
			textureLod(opaqueImage, uvG, 0.0).rgb +
			textureLod(transparentImage, uvG, 0.0).rgb;

		vec3 sceneB =
			textureLod(opaqueImage, uvB, 0.0).rgb +
			textureLod(transparentImage, uvB, 0.0).rgb;

		hdrScene = vec3(sceneR.r, sceneG.g, sceneB.b);
	}

	vec3 hdr = max(hdrScene + volumetricLight + lensFlare, 0.0);

	float exposure = LuminanceBuffer(globalAddressTable.addrs[ABT_Luminance]).luminanceSums[0].x;
	exposure = max(exposure, 1e-4);

	vec3 mapped = ACESFilm(hdr * exposure);

	float noise = noiseHash(pid);
	mapped += (noise - 0.5) / 2048.0;

	imageStore(toneMapImage, pid, vec4(mapped, 1.0));
}