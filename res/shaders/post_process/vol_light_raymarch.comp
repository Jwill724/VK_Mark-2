#version 450

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/shadow.glsl"
#include "../include/depth.glsl"

// Good resources to understand how volumetric lights work
// https://www.scratchapixel.com/lessons/3d-basic-rendering/volume-rendering-for-developers/ray-marching-get-it-right.html
// https://www.gamedeveloper.com/programming/atmospheric-scattering-and-volumetric-fog-algorithm-part-1#close-modal
// https://www.youtube.com/watch?v=G0sYTrX3VHI

layout(local_size_x = 16, local_size_y = 16) in;

const int MAX_STEPS = 20;

// Rotates which full-res texel each half-res thread owns, 4-frame cycle.
// Must match the table in the resolve and blur passes exactly.
const ivec2 kSubsampleOffsets[4] = ivec2[4](
	ivec2(0, 0), ivec2(1, 1), ivec2(1, 0), ivec2(0, 1)
);

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outVolumetricLight;

layout(push_constant) uniform VolumetricPush
{
	float density;             // overall fog density
	float scatteringStrength;  // brightness of scattered light
	float extinction;          // how fast light is absorbed
	float heightFalloff;       // vertical fog falloff

	float maxDistance;         // max ray length in world/view units
	float jitterStrength;      // scales step jitter for banding hiding
	float asymmetryFactor;     // phase function asymmetry factor (g)
	float minTransmittance;    // minimum remaining light before fully attenuated

	int   beamPower;           // Determines how tight or wide beams are

	// Blur (shared by X/Y passes)
	float blurRadius;          // kernel radius in half-res pixels
	float blurDepthSigma;      // depth sensitivity for bilateral blur
	float blurWeightSigma;     // Gaussian width

	vec2 blurDirection;        // (1,0) for horizontal, (0,1) for vertical

	float historyWeight;       // max fraction of history kept in the resolve pass
	float clipGamma;           // variance clip box width in the resolve pass
} pc;

float sampleJitter(ivec2 pixelCoord)
{
	return temporalInterleavedGradientNoise(vec2(pixelCoord), int(scene.temporal.x), float(scene.temporal.y));
}

float phaseHenyeyGreenstein(float cosTheta, float g)
{
	float g2    = g * g;
	float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 0.0001);
	return 1.0 / (4.0 * 3.14159265359) * (1.0 - g2) / (denom * sqrt(denom));
}

void main()
{
	ivec2 pixelCoord  = ivec2(gl_GlobalInvocationID.xy);
	ivec2 halfResSize = imageSize(outVolumetricLight);

	if (any(greaterThanEqual(pixelCoord, halfResSize))) return;

	SceneData    scene = getSceneData();
	DebugToggles debug = getDebugToggles();
	VolumetricShadowInfo volShadow = getVolumetricShadowInfo();

	uint  frameIndex    = scene.temporal.x;
	ivec2 fullResSize   = textureSize(inDepth, 0);
	ivec2 fullCoord     = min(pixelCoord * 2 + kSubsampleOffsets[frameIndex & 3u], fullResSize - 1);
	vec2  fullPixelSize = vec2(scene.pixelSizes.xy);
	vec2  uv            = (vec2(fullCoord) + 0.5) * fullPixelSize;

	// Shadow map rotation hash
	mat2 poissonRotation = createHashTemporal(vec2(pixelCoord), scene.temporal.x);

	float depthValue     = texelFetch(inDepth, fullCoord, 0).r;
	bool  hasHitGeometry = depthValue >= DEPTH_EPSILON_REVERSED_Z;

	vec3 viewRayVS = cheapReconstructViewPos(uv, 1.0, scene.ndcToViewMult, scene.ndcToViewAdd);
	vec3 viewDir   = normalize(mat3(scene.invView) * viewRayVS);

	vec3  sunDir   = normalize(scene.sunlightDirection.xyz);
	float cosTheta = dot(viewDir, sunDir);

	// If sun is mostly behind camera
	// Alpha still carries a usable anchor so the resolve pass reprojects somewhere sane.
	if (cosTheta <= 0.0) {
		imageStore(outVolumetricLight, pixelCoord, vec4(0.0, 0.0, 0.0, pc.maxDistance));
		return;
	}

	// Only march until geometry is hit
	float maxRayDistance = pc.maxDistance;
	if (hasHitGeometry) {
		float surfaceViewDepth = screenToViewDepth(depthValue, scene.depthLinearizeMult, scene.depthLinearizeAdd);
		maxRayDistance = min(maxRayDistance,
			length(cheapReconstructViewPos(uv, surfaceViewDepth, scene.ndcToViewMult, scene.ndcToViewAdd)));
	}

	if (maxRayDistance <= 0.0) {
		imageStore(outVolumetricLight, pixelCoord, vec4(0.0, 0.0, 0.0, pc.maxDistance));
		return;
	}

	float dirMask = pow(clamp(cosTheta, 0.0, 1.0), float(pc.beamPower));

	// Phase function
	float phase = phaseHenyeyGreenstein(cosTheta, pc.asymmetryFactor);

	// Jitter the starting position along the ray to reduce banding
	float stepLength = maxRayDistance / float(MAX_STEPS);
	float rayT       = clamp(sampleJitter(pixelCoord) * pc.jitterStrength, 0.0, 0.999) * stepLength;

	// Extinction
	float extinctionCoeff = pc.density * pc.extinction;
	float segmentTrans    = exp(-extinctionCoeff * stepLength);

	// Scattering
	vec3 sunColor    = scene.sunlightColor.rgb * scene.sunlightColor.a;
	vec3 baseScatter = sunColor * pc.density * phase * dirMask * pc.scatteringStrength;

	vec3  cameraWorldPos = scene.cameraPos.xyz;
	vec3  camForward     = -vec3(scene.invView[0][2], scene.invView[1][2], scene.invView[2][2]);
	float forwardDot     = dot(camForward, viewDir);

	// Shadow info
	ViewReconstructResult reconstructPos;
	reconstructPos.pos       = cameraWorldPos + viewDir * rayT;
	reconstructPos.viewDepth = forwardDot * rayT;

	// Height factor
	float heightStart  = max(cameraWorldPos.y + viewDir.y * rayT, 0.0);
	float heightFactor = exp(-pc.heightFalloff * heightStart);
	float heightStep   = exp(-pc.heightFalloff * viewDir.y * stepLength);

	vec3  accumulatedLight = vec3(0.0);
	float transmittance    = 1.0;

	// Transmittance-weighted mean scattering distance, written to alpha for the
	// resolve pass to reproject against. Geometry motion vectors are useless for
	// fog sitting in empty space.
	float anchorWeighted  = 0.0;
	float anchorWeightSum = 0.0;

	for (int i = 0; i < MAX_STEPS; ++i) {
		if (rayT > maxRayDistance) break;

		reconstructPos.pos       = cameraWorldPos + viewDir * rayT;
		reconstructPos.viewDepth = forwardDot * rayT;

		// Ray march guided by shadow map
		float shadowTerm =
			sampleVolumetricShadowMap(
				volShadow,
				reconstructPos.pos,
				poissonRotation);

		vec3  contribution = baseScatter * heightFactor * shadowTerm * transmittance * stepLength;
		float contribLuma  = luminance(contribution);

		accumulatedLight += contribution;
		anchorWeighted   += contribLuma * rayT;
		anchorWeightSum  += contribLuma;

		transmittance *= segmentTrans;
		heightFactor  *= heightStep;

		if (transmittance < pc.minTransmittance) break;

		rayT += stepLength;
	}

	float anchorDistance = (anchorWeightSum > 1e-8)
		? anchorWeighted / anchorWeightSum
		: maxRayDistance * 0.5;

	imageStore(outVolumetricLight, pixelCoord, vec4(accumulatedLight, anchorDistance));
}
