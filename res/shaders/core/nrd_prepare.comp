#version 460
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/depth.glsl"
#include "../include/nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D  uDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform usampler2D uNormalMetal;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D  uAlbedoRough;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D  uVelocity;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rg16f)    uniform writeonly image2D uMotion;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2, rgb10_a2) uniform writeonly image2D uNormalRoughness;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_3, r32f)     uniform writeonly image2D uViewZ;

layout(push_constant) uniform NRDPush
{
	vec2 resSize;
	vec2 resTexel;
	uint writeMotion;
} pc;

void main()
{
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(px, ivec2(pc.resSize)))) return;

	SceneData sd = getSceneData();

	vec2  uv       = (vec2(px) + 0.5) * pc.resTexel;
	float depthRaw = textureLod(uDepth, uv, 0.0).r;

	if (pc.writeMotion != 0u)
	{
		imageStore(uMotion, px, vec4(-textureLod(uVelocity, uv, 0.0).rg, 0.0, 0.0));
	}

	if (depthRaw <= 0.0)
	{
		imageStore(uViewZ,           px, vec4(sd.cameraClips.y * 2.0));
		imageStore(uNormalRoughness, px, NRD_PackNormalAndRoughness(vec3(0.0, 0.0, 1.0), 1.0));
		return;
	}

	float viewZ = screenToViewDepth(depthRaw, sd.depthLinearizeMult, sd.depthLinearizeAdd);
	imageStore(uViewZ, px, vec4(viewZ));

	vec3  N = unpackGBufferNormal(textureLod(uNormalMetal, uv, 0.0).r);
	float r = textureLod(uAlbedoRough, uv, 0.0).a;

	imageStore(uNormalRoughness, px, NRD_PackNormalAndRoughness(N, r * r));
}
