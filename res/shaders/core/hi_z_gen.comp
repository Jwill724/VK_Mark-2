#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Mip 0 source: resolved depth (float)
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inDepthResolved;

// Mip N source: previous HZB mip (packed uint)
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform usampler2D inHiZPacked;

// Output: current HZB mip (packed uint)
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform uimage2D outMip;

layout(push_constant) uniform DepthPyramidPush {
	uint mipLevel;
	float pad0;
	vec2 invSize; // 1.0 / current mip res
} pc;

void main()
{
	ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);

	// Reconstruct source and destination sizes from invSize
	float srcWidthF = 1.0 / pc.invSize.x;
	float srcHeightF = 1.0 / pc.invSize.y;

	int srcWidth = int(srcWidthF + 0.5);
	int srcHeight = int(srcHeightF + 0.5);

	int dstWidth;
	int dstHeight;

	if (pc.mipLevel == 0u) {
		dstWidth = srcWidth;
		dstHeight = srcHeight;
	} else {
		dstWidth = max(1, srcWidth / 2);
		dstHeight = max(1, srcHeight / 2);
	}

	if (dstCoord.x >= dstWidth || dstCoord.y >= dstHeight) return;

	if (pc.mipLevel == 0u) {
		float rawDepth = texelFetch(inDepthResolved, dstCoord, 0).r;

		// In ratio scheme both min/max in [0,1]. For mip0 min==max.
		float depth01 = clamp(rawDepth, 0.0, 1.0);

		uint packed = packHZB(depth01, depth01);
		imageStore(outMip, dstCoord, uvec4(packed, 0u, 0u, 0u));
	}
	else {
		// Mip N: Downsample from mip N - 1
		ivec2 srcCoordBase = dstCoord * 2;

		ivec2 maxSrcCoord = ivec2(srcWidth - 1, srcHeight - 1);

		ivec2 c00 = clamp(srcCoordBase, ivec2(0), maxSrcCoord);
		ivec2 c10 = clamp(srcCoordBase + ivec2(1, 0), ivec2(0), maxSrcCoord);
		ivec2 c01 = clamp(srcCoordBase + ivec2(0, 1), ivec2(0), maxSrcCoord);
		ivec2 c11 = clamp(srcCoordBase + ivec2(1, 1), ivec2(0), maxSrcCoord);

		uint p00 = texelFetch(inHiZPacked, c00, 0).r;
		uint p10 = texelFetch(inHiZPacked, c10, 0).r;
		uint p01 = texelFetch(inHiZPacked, c01, 0).r;
		uint p11 = texelFetch(inHiZPacked, c11, 0).r;

		float min00, max00; unpackHZB(p00, min00, max00);
		float min10, max10; unpackHZB(p10, min10, max10);
		float min01, max01; unpackHZB(p01, min01, max01);
		float min11, max11; unpackHZB(p11, min11, max11);

		// min = nearest, max = farthest.
		float outMin = min(min(min00, min10), min(min01, min11));
		float outMax = max(max(max00, max10), max(max01, max11));

		uint packedOut = packHZB(outMin, outMax);
		imageStore(outMip, dstCoord, uvec4(packedOut, 0u, 0u, 0u));
	}
}
