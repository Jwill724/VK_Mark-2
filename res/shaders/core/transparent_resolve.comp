#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D accumImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D revealImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D resolvedTransparent;

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 dim   = imageSize(resolvedTransparent);
	if (any(greaterThanEqual(coord, dim))) return;

	vec4  accum  = texelFetch(accumImage,  coord, 0);
	float reveal = texelFetch(revealImage, coord, 0).r;

	if (reveal >= 0.9999)
	{
		imageStore(resolvedTransparent, coord, vec4(0.0));
		return;
	}

	vec3  color = accum.rgb / max(accum.a, 1e-5);
	float alpha = 1.0 - reveal;

	imageStore(resolvedTransparent, coord, vec4(color * alpha, 1.0));
}
