#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/clustered.glsl"
#include "../include/common.glsl"
#include "../include/depth.glsl"
#include "../include/shadow.glsl"
#include "../include/pbr.glsl"
#include "../include/lighting.glsl"

#define TILE_DIM 16u

const uint WG_THREADS = TILE_DIM * TILE_DIM;

layout(local_size_x = TILE_DIM, local_size_y = TILE_DIM) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D  gbAlbedoRough;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform usampler2D gbNormalMaterial;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D  gbEmissive;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D  depthTex;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D  prepassViewNormal;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform sampler2D  contactShadowMask;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_7) uniform sampler2D  bentNormalAO;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D hdrColor;

layout(push_constant) uniform TileShadePush
{
	uint diffuseID;
	uint specularID;
	uint brdfID;
	float oitDepthScale;

	uint flashlightShadowMapID;
	uint flashlightCookieTexID;
} pc;


// ========================================
// Shared memory: per-workgroup light list
// ========================================
#define LIGHT_MASK_WORDS ((MAX_LIGHTS + 31u) / 32u)
#define MAX_TILE_LIGHTS  256u

shared uint sDepthMinBits;
shared uint sDepthMaxBits;
shared uint sLightMask[LIGHT_MASK_WORDS];
shared uint sWordBase[LIGHT_MASK_WORDS];
shared uint sTileLights[MAX_TILE_LIGHTS];
shared uint sSliceMin;
shared uint sSliceMax;

void main()
{
	SceneData     scene         = getSceneData();
	ClusteredData clusteredData = getClusteredData();
	DebugToggles  debug         = getDebugToggles();

	uvec2 gid    = gl_GlobalInvocationID.xy;
	uint  tid    = gl_LocalInvocationIndex;
	uvec2 vpSize = uvec2(scene.viewportSize.xy);
	bool  inBounds = all(lessThan(gid, vpSize));

	if (tid == 0u)
	{
		sDepthMinBits   = 0x7F7FFFFFu; // +FLT_MAX bits
		sDepthMaxBits   = 0u;
	}

	for (uint w = tid; w < LIGHT_MASK_WORDS; w += WG_THREADS) sLightMask[w] = 0u;
	barrier();

	float rawDepth  = 0.0;
	float viewDepth = 0.0;
	vec3  worldPos  = vec3(0.0);
	bool  isSky     = true;

	vec2 screenspace_uv = (vec2(gid) + 0.5) / vec2(vpSize);

	if (inBounds)
	{
		rawDepth = texelFetch(depthTex, ivec2(gid), 0).r;
		isSky    = (rawDepth <= 0.0); // reversed-Z far plane

		if (!isSky)
		{
			ViewReconstructResult r = reconstructWorldPosFromDepth(
				screenspace_uv, rawDepth, scene.invProj, scene.invView);
			worldPos  = r.pos;
			viewDepth = r.viewDepth;

			atomicMin(sDepthMinBits, floatBitsToUint(viewDepth));
			atomicMax(sDepthMaxBits, floatBitsToUint(viewDepth));
		}
	}
	barrier();

	bool wholeTileSky = (sDepthMaxBits == 0u);

	// Cluster depth slice range
	if (tid == 0u && !wholeTileSky)
	{
		float dMin  = uintBitsToFloat(sDepthMinBits);
		float dMax  = uintBitsToFloat(sDepthMaxBits);
		float nearP = scene.cameraClips.x;
		float farP  = scene.cameraClips.y;

		sSliceMin = depthToSliceLog(clamp(dMin, nearP + 1e-6, farP), nearP, farP, clusteredData.zSlices);
		sSliceMax = depthToSliceLog(clamp(dMax, nearP + 1e-6, farP), nearP, farP, clusteredData.zSlices);
	}
	barrier();

	// bitmask union over the occupied slices of the cluster tile containing this workgroup
	if (!wholeTileSky && debug.activeLightCount > 0u)
	{
		ClusterCounts   countsBuf  = getClusterCountsBuffer();
		ClusterOffsets  offsetsBuf = getClusterOffsetsBuffer();
		ClusterLightIDs idsBuf     = getClusterLightIDsBuffer();

		uvec2 basePixel = gl_WorkGroupID.xy * TILE_DIM;
		uvec2 tileCoord = uvec2(
			min(basePixel.x / clusteredData.tileSizeX, clusteredData.tileCountX - 1u),
			min(basePixel.y / clusteredData.tileSizeY, clusteredData.tileCountY - 1u));
		uint tileIndex = tileCoord.y * clusteredData.tileCountX + tileCoord.x;
		uint tileCount = clusteredData.tileCountX * clusteredData.tileCountY;

		for (uint slice = sSliceMin; slice <= sSliceMax; ++slice)
		{
			uint clusterIndex = slice * tileCount + tileIndex;
			uint count  = min(countsBuf.counts[clusterIndex], clusteredData.maxLightsPerCluster);
			uint offset = offsetsBuf.offsets[clusterIndex];

			for (uint i = tid; i < count; i += WG_THREADS)
			{
				uint lightID = idsBuf.lightIDs[offset + i];
				atomicOr(sLightMask[lightID >> 5u], 1u << (lightID & 31u));
			}
		}
	}
	barrier();

	// compact mask -> list
	uint myWord = (tid < LIGHT_MASK_WORDS) ? sLightMask[tid] : 0u;

	if (tid < LIGHT_MASK_WORDS)
	{
		sWordBase[tid] = bitCount(myWord);
	}
	barrier();

	for (uint stride = 1u; stride < LIGHT_MASK_WORDS; stride <<= 1u)
	{
		uint addValue = 0u;
		if (tid < LIGHT_MASK_WORDS && tid >= stride) addValue = sWordBase[tid - stride];
		barrier();
		if (tid < LIGHT_MASK_WORDS) sWordBase[tid] += addValue;
		barrier();
	}

	uint tileLightCount = min(sWordBase[LIGHT_MASK_WORDS - 1u], MAX_TILE_LIGHTS);

	if (tid < LIGHT_MASK_WORDS)
	{
		uint slot = sWordBase[tid] - bitCount(myWord); // inclusive -> exclusive
		uint word = myWord;
		while (word != 0u)
		{
			uint bit = uint(findLSB(word));
			word &= word - 1u;
			if (slot < MAX_TILE_LIGHTS)
			{
				sTileLights[slot] = (tid << 5u) | bit;
			}
			++slot;
		}
	}
	barrier(); // per-pixel exits are legal after this

	if (!inBounds || isSky) return;

	// ==================
	// Per-pixel shading
	// ==================
	vec4  ar       = texelFetch(gbAlbedoRough, ivec2(gid), 0);
	vec3  albedo   = ar.rgb * ar.rgb;
	float rough    = ar.a * ar.a;

	uint packedMat = texelFetch(gbNormalMaterial, ivec2(gid), 0).r;
	vec3 N;
	float metal;
	unpackNormalMetal(packedMat, N, metal);

	vec3  emissive = texelFetch(gbEmissive, ivec2(gid), 0).rgb;
	vec3  vsN      = octDecode(texelFetch(prepassViewNormal, ivec2(gid), 0).rg * 2.0 - 1.0);
	vec3  geometricNormalWS = normalize(mat3(scene.invView) * vsN);

	vec3 sunColor = scene.sunlightColor.rgb * scene.sunlightColor.a;
	vec3 V = normalize(scene.cameraPos.xyz - worldPos);
	vec3 L = normalize(scene.sunlightDirection.xyz);
	vec3 H = normalize(V + L);

	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	float LdotH = max(dot(L, H), 0.0);

	// Screen space ambient occlusion

	float aoTerm = 1.0;
	vec4 bentAo = texelFetch(bentNormalAO, ivec2(gid), 0);

	if (DBG(aoMode))
	{
		aoTerm *= bentAo.a;
	}

	// Screen space contact shadow
	float contactShadows = 1.0;
	if (DBG(enableSSS) && DBG(enableShadows))
	{
		contactShadows = texture(contactShadowMask, screenspace_uv).r;
	}

	vec3 F0 = mix(vec3(0.04), albedo, metal);
	vec3 F  = F_SchlickRoughness(F0, NdotV, rough);
	vec3 kD = (1.0 - F) * (1.0 - metal);

	vec3 diff = DisneyDiffuse(albedo, rough, NdotV, NdotL, LdotH);
	vec3 spec = BRDF_Specular(NdotV, NdotL, N, V, H, F0, rough);

	vec2 brdf = SampleTexture(pc.brdfID, vec2(NdotV, rough)).rg;
	vec3 multiScatterComp = MultiScatterEnergyComp(F0, brdf);
	spec *= multiScatterComp;

	vec2 fragCoord = vec2(gid) + 0.5;
	mat2 shadowHash = (debug.aaMode != AA_TAA)
		? createHash(fragCoord)
		: createHashTemporal(fragCoord, scene.temporal.x);

	// Cascaded shadow maps
	float shadow = 1.0;
	if (DBG(enableShadows))
	{
		ShadowCSM   csm          = getShadowCSM();
		const uint  shadowMapID  = uint(csm.params.x);
		const uint  cascadeCount = uint(csm.params.y);
		const float texel        = csm.params.z;
		const uint  cascadeClamped = cascadeCount - 1u;

		const uvec4 activeCascades = getShadowCullDataBuffer().data.cascadeActive;

		uint        cascadeIdx = cascadeViewDepthSplit(viewDepth, cascadeCount, csm.cascadeSplits);
		CascadeProj cur;
		cur.valid = false;

		for (uint c = cascadeIdx; c < cascadeCount; ++c)
		{
			CascadeProj p = buildCascadeProj(csm, activeCascades, c,
				worldPos, geometricNormalWS, L, texel);

			if (p.valid)
			{
				cur = p;
				cascadeIdx = c;
				break;
			}
		}

		if (cur.valid)
		{
			float sA = sampleCascade(cur, shadowHash, shadowMapID, texel);
			shadow   = sA;

			// Next usable cascade for the transition blend — also skipping
			// inactive tiles, so a deactivated cascade can never bleed in.
			uint        nextIdx = cascadeIdx + 1u;
			CascadeProj nxt;
			nxt.valid = false;

			for (uint c = nextIdx; c < cascadeCount; ++c)
			{
				CascadeProj p = buildCascadeProj(csm, activeCascades, c,
					worldPos, geometricNormalWS, L, texel);

				if (p.valid)
				{
					nxt = p;
					break;
				}
			}

			const float blendEnd = csm.cascadeSplits[cascadeIdx];

			if (nxt.valid)
			{
				// Blending between cascades for smooth transitions.
				float blendStart = blendEnd * CASCADE_BLEND_FRACTION;
				if (viewDepth >= blendStart)
				{
					float sB          = sampleCascade(nxt, shadowHash, shadowMapID, texel);
					float blendFactor = smoothstep(blendStart, blendEnd, viewDepth);
					shadow            = mix(sA, sB, blendFactor);
				}
			}
			else
			{
				// Nothing usable beyond this cascade — whether it's the last one
				// or the rest were deactivated. Fade to lit rather than cutting off.
				float blendStart = blendEnd * CASCADE_LAST_FADE_FRACTION;
				if (viewDepth >= blendStart)
				{
					float blendFactor = smoothstep(blendStart, blendEnd, viewDepth);
					shadow            = mix(sA, 1.0, blendFactor);
				}
			}
		}
	}

	// Local lights: uniform-bound loop over the shared tile list.
	LightBuffer lightBuf = getLightBuffer();
	vec3 localLightColor = vec3(0.0);

	for (uint i = 0u; i < tileLightCount; ++i)
	{
		LocalLight light = lightBuf.lights[sTileLights[i]];

		if (light.lightType == LIGHT_TYPE_POINT)
		{
			float pointNdotL = 0.0;
			vec3 pointResult = evaluatePointLight(
				light, worldPos, scene.cameraPos.xyz, N, V, NdotV,
				albedo, F0, rough, pointNdotL);

			pointResult *= MicroShadowVisibility(pointNdotL, aoTerm);
			localLightColor += pointResult;
		}
		else if (light.lightType == LIGHT_TYPE_SPOT)
		{
			const bool isFlashLight    = (light.flags & LIGHT_FLAG_FLASHLIGHT) != 0u;
			const bool isFlashLightOff = (light.flags & LIGHT_FLAG_FLASHLIGHT_OFF) != 0u;

			if (isFlashLight && isFlashLightOff) continue;

			float spotNdotL = 0.0;
			vec3 lightResult = evaluateSpotLight(
				light, worldPos, scene.cameraPos.xyz, N, V, NdotV,
				albedo, F0, rough, spotNdotL);

			lightResult *= MicroShadowVisibility(spotNdotL, aoTerm);

			bool castsShadow = (light.flags & LIGHT_FLAG_CASTS_SPOT_SHADOW) != 0u;
			if (castsShadow && isFlashLight && !isFlashLightOff)
			{
				vec4 flashlightSpacePos   = scene.flashlightVP * vec4(worldPos, 1.0);
				vec3 flashlightProjCoords = flashlightSpacePos.xyz / flashlightSpacePos.w;

				vec2 flashlightShadowUV = flashlightProjCoords.xy * 0.5 + 0.5;
				flashlightShadowUV.y    = 1.0 - flashlightShadowUV.y;

				float flashlightShadowZ = flashlightProjCoords.z;

				if (!(flashlightShadowUV.x < 0.0 || flashlightShadowUV.x > 1.0 ||
					  flashlightShadowUV.y < 0.0 || flashlightShadowUV.y > 1.0 ||
					  flashlightShadowZ    < 0.0 || flashlightShadowZ    > 1.0))
				{
					float angleScale = 1.0 - clamp(spotNdotL, 0.0, 1.0);
					float flashlightShadowBias = MIN_SHADOW_BIAS * (0.25 + angleScale * 0.65);

					float shadowTerm = PCFPoissonLow(
						shadowHash,
						pc.flashlightShadowMapID,
						flashlightShadowUV,
						flashlightShadowZ,
						flashlightShadowBias,
						FLASHLIGHT_TEXEL_SIZE);

					lightResult *= shadowTerm;
				}

				float cookieGobo = 0.0;
				if (!(flashlightShadowUV.x < 0.0 || flashlightShadowUV.x > 1.0 ||
					  flashlightShadowUV.y < 0.0 || flashlightShadowUV.y > 1.0))
				{
					float rawCookie = SampleTexture(pc.flashlightCookieTexID, flashlightShadowUV).r;
					cookieGobo      = pow(rawCookie, 2.0);
				}

				lightResult *= cookieGobo;
			}

			localLightColor += lightResult;
		}
	}

	// Sun + IBL + ambient
	float microVisSun = MicroShadowVisibility(NdotL, aoTerm);
	vec3 direct = (diff + spec) * sunColor * NdotL * shadow * microVisSun * contactShadows;

	vec3 iblSpec = sampleSpecIBL(V, N, rough, F0, brdf, pc.specularID);
	iblSpec *= multiScatterComp;

	vec3 irradianceN = N;
	if (debug.aoMode == AO_VBAO_BENT_NORMALS)
	{
		vec3  bentWS         = octDecode(bentAo.rg * 2.0 - 1.0);
		float bentDeviation  = 1.0 - saturate(dot(N, bentWS));
		float coneConfidence = 1.0 - saturate(bentAo.b);

		float bentBlend = clamp(bentDeviation * coneConfidence, 0.0, 0.5);
		irradianceN     = normalize(mix(N, bentWS, bentBlend));
	}
	vec3 iblDiff = sampleIrradiance(irradianceN, pc.diffuseID) * albedo;

	vec3 ambientDiffuse  = kD * (iblDiff * aoTerm);
	float specAO         = SpecAO_Conservative(aoTerm, NdotV, rough);
	vec3 ambientSpecular = iblSpec * specAO;

	vec3 ambient = ambientDiffuse + ambientSpecular;

	vec3 color = emissive + direct + localLightColor + ambient;

	imageStore(hdrColor, ivec2(gid), vec4(color, 1.0));
}
