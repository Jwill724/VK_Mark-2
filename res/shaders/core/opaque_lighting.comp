#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/clustered.glsl"
#include "../include/common.glsl"
#include "../include/pbr.glsl"
#include "../include/depth.glsl"
#include "../include/shadow.glsl"
#include "../include/lighting.glsl"
#include "../include/barycentric.glsl"
#include "../include/visbuffer.glsl"
#include "../include/nrd_common.glsl"

#define TILE_DIM 16u

const uint WG_THREADS = TILE_DIM * TILE_DIM;

layout(local_size_x = TILE_DIM, local_size_y = TILE_DIM) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D  gbAlbedoRough;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform usampler2D gbNormalMaterial;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D  gbEmissive;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D  depthTex;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D  prepassViewNormal;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform sampler2D  contactShadowMask;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_7) uniform sampler2D  bentNormalAO;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_8) uniform sampler2D  giIndirect;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_9) uniform sampler2D  rtReflectDenoised;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_10) uniform sampler2D rtShadowDenoised;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_11) uniform usampler2D visBuffer;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D hdrColor;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2) writeonly uniform image2D diffuseRadianceHalf;

layout(push_constant) uniform TileShadePush
{
	vec2 halfTexel;
	uint specularID;
	uint brdfID;
	float oitDepthScale;
	float bounceFeedback;
	float giIntensity;
	uint flashlightShadowMapID;
	uint flashlightCookieTexID;
	float reflectRoughFade;
	float reflectRoughCutoff;
} pc;

// ========================================
// Shared memory: per-workgroup light list
// ========================================
#define LIGHT_MASK_WORDS ((MAX_LIGHTS + 31u) / 32u)
#define MAX_TILE_LIGHTS  256u

shared uint sDepthMinBits;
shared uint sDepthMaxBits;
shared uint sLightMask[LIGHT_MASK_WORDS];
shared uint sWordBase[LIGHT_MASK_WORDS];
shared uint sTileLights[MAX_TILE_LIGHTS];
shared uint sSliceMin;
shared uint sSliceMax;
shared vec4 sDiffuseRadiance[WG_THREADS];

void main()
{
	SceneData     scene         = getSceneData();
	ClusteredData clusteredData = getClusteredData();
	DebugToggles  debug         = getDebugToggles();
	uint visibleLightCount      = getVisibleLightCountBuffer().count;

	uvec2 gid    = gl_GlobalInvocationID.xy;
	uint  tid    = gl_LocalInvocationIndex;
	uvec2 vpSize = uvec2(scene.viewportSize.xy);
	bool  inBounds = all(lessThan(gid, vpSize));

	if (tid == 0u)
	{
		sDepthMinBits = MAX_FLT_UINT;
		sDepthMaxBits = 0u;
	}

	for (uint w = tid; w < LIGHT_MASK_WORDS; w += WG_THREADS) sLightMask[w] = 0u;
	barrier();

	float rawDepth  = 0.0;
	float viewDepth = 0.0;
	vec3  worldPos  = vec3(0.0);
	bool  isSky     = true;

	vec2 screenspace_uv = (vec2(gid) + 0.5) / vec2(vpSize);

	if (inBounds)
	{
		rawDepth = texelFetch(depthTex, ivec2(gid), 0).r;
		isSky    = (rawDepth <= 0.0); // reversed-Z far plane

		if (!isSky)
		{
			ViewReconstructResult r = reconstructWorldPosFromDepth(
				screenspace_uv, rawDepth, scene.invProj, scene.invView);
			worldPos  = r.pos;
			viewDepth = r.viewDepth;

			atomicMin(sDepthMinBits, floatBitsToUint(viewDepth));
			atomicMax(sDepthMaxBits, floatBitsToUint(viewDepth));
		}
	}
	barrier();

	bool wholeTileSky = (sDepthMaxBits == 0u);

	if (tid == 0u && !wholeTileSky)
	{
		float dMin  = uintBitsToFloat(sDepthMinBits);
		float dMax  = uintBitsToFloat(sDepthMaxBits);
		float nearP = scene.cameraClips.x;
		float farP  = scene.cameraClips.y;

		sSliceMin = depthToSliceLog(clamp(dMin, nearP + 1e-6, farP), nearP, farP, clusteredData.zSlices);
		sSliceMax = depthToSliceLog(clamp(dMax, nearP + 1e-6, farP), nearP, farP, clusteredData.zSlices);
	}
	barrier();

	if (!wholeTileSky && visibleLightCount > 0)
	{
		ClusterCounts   countsBuf  = getClusterCountsBuffer();
		ClusterOffsets  offsetsBuf = getClusterOffsetsBuffer();
		ClusterLightIDs idsBuf     = getClusterLightIDsBuffer();

		uvec2 basePixel = gl_WorkGroupID.xy * TILE_DIM;
		uvec2 tileCoord = uvec2(
			min(basePixel.x / clusteredData.tileSizeX, clusteredData.tileCountX - 1u),
			min(basePixel.y / clusteredData.tileSizeY, clusteredData.tileCountY - 1u));
		uint tileIndex = tileCoord.y * clusteredData.tileCountX + tileCoord.x;
		uint tileCount = clusteredData.tileCountX * clusteredData.tileCountY;

		for (uint slice = sSliceMin; slice <= sSliceMax; ++slice)
		{
			uint clusterIndex = slice * tileCount + tileIndex;
			uint count  = min(countsBuf.counts[clusterIndex], clusteredData.maxLightsPerCluster);
			uint offset = offsetsBuf.offsets[clusterIndex];

			for (uint i = tid; i < count; i += WG_THREADS)
			{
				uint lightID = idsBuf.lightIDs[offset + i];
				atomicOr(sLightMask[lightID >> 5u], 1u << (lightID & 31u));
			}
		}
	}
	barrier();

	uint myWord = (tid < LIGHT_MASK_WORDS) ? sLightMask[tid] : 0u;

	if (tid < LIGHT_MASK_WORDS)
	{
		sWordBase[tid] = bitCount(myWord);
	}
	barrier();

	for (uint stride = 1u; stride < LIGHT_MASK_WORDS; stride <<= 1u)
	{
		uint addValue = 0u;
		if (tid < LIGHT_MASK_WORDS && tid >= stride) addValue = sWordBase[tid - stride];
		barrier();
		if (tid < LIGHT_MASK_WORDS) sWordBase[tid] += addValue;
		barrier();
	}

	uint tileLightCount = min(sWordBase[LIGHT_MASK_WORDS - 1u], MAX_TILE_LIGHTS);

	if (tid < LIGHT_MASK_WORDS)
	{
		uint slot = sWordBase[tid] - bitCount(myWord);
		uint word = myWord;
		while (word != 0u)
		{
			uint bit = uint(findLSB(word));
			word &= word - 1u;
			if (slot < MAX_TILE_LIGHTS)
			{
				sTileLights[slot] = (tid << 5u) | bit;
			}
			++slot;
		}
	}
	barrier();

	vec3  diffuseRadiance = vec3(0.0);

	if (inBounds && !isSky)
	{
		vec4  ar     = texelFetch(gbAlbedoRough, ivec2(gid), 0);
		vec3  albedo = ar.rgb * ar.rgb;
		float rough  = ar.a * ar.a;

		uint packedMat = texelFetch(gbNormalMaterial, ivec2(gid), 0).r;
		vec3  N;
		float metal;
		unpackNormalMetal(packedMat, N, metal);

		uvec2 visIds       = texelFetch(visBuffer, ivec2(gid), 0).xy;
		InstanceInput inst = getInstanceInputBuffer().instanceInputs[visInstanceID(visIds.x)];
		Material      mat  = getMaterialBuffer().materials[inst.materialID];

		Surface opaqueSurface = makeSurface(
			worldPos, N, scene.cameraPos.xyz, albedo, metal, rough, mat, pc.brdfID);

		if ((inst.flags & DOUBLE_SIDED) != 0u)
			opaqueSurface.diffuseTrans = max(opaqueSurface.diffuseTrans, DOUBLE_SIDED_TRANS_FLOOR);

		vec3 emissive = texelFetch(gbEmissive, ivec2(gid), 0).rgb;
		vec3 vsN      = octDecode(texelFetch(prepassViewNormal, ivec2(gid), 0).rg * 2.0 - 1.0);
		vec3 geometricNormalWS = normalize(mat3(scene.invView) * vsN);

		vec3 sunColor = scene.sunlightColor.rgb * scene.sunlightColor.a;
		vec3 L = normalize(scene.sunlightDirection.xyz);

		float aoTerm = 1.0;
		vec3 bentWS = N;
		float bentConf = 0.0;
		if (debug.giMode != OFF)
		{
			vec4 bentAo = texelFetch(bentNormalAO, ivec2(gid), 0);
			aoTerm *= bentAo.a;

			if (debug.giMode == VBGI)
			{
				bentWS   = normalize(bentAo.rgb * 2.0 - 1.0);
				bentConf = 1.0 - aoTerm;
			}
		}

		float specAO = SpecAO_Conservative(aoTerm, opaqueSurface.NdotV, rough);
		if (bentConf > 0.0)
		{
			vec3  R          = reflect(-opaqueSurface.V, N);
			float bentSpecAO = bentConeVisibility(bentWS, R, aoTerm);
			specAO = mix(specAO, min(specAO, bentSpecAO), bentConf * (1.0 - rough));
		}

		float contactShadows = 1.0;
		if (DBG(enableSSS))
		{
			contactShadows = texture(contactShadowMask, screenspace_uv).r;
		}

		vec2 fragCoord = vec2(gid) + 0.5;
		mat2  shadowHash        = createHashTemporal(fragCoord, scene.temporal.x);
		float shadowPhase       = createPhaseTemporal(fragCoord, scene.temporal.x);
		float shadowPhaseStable = createPhase(fragCoord);
		float shadowJitter      = temporalInterleavedGradientNoise(
			fragCoord + 37.0, int(scene.temporal.x), 1.0);

		float shadow = 1.0;
		if (DBG(enableShadows))
		{
			if (debug.sunShadowFilter == SUN_SHADOW_FILTER_RT_SOFT)
			{
				shadow = SIGMA_BackEnd_UnpackShadow(
					texelFetch(rtShadowDenoised, ivec2(gid), 0).r);
			}
			else if (!DBG(csmAtlasCached))
			{
				shadow = sampleSunShadowCSM(
					worldPos,
					geometricNormalWS,
					L,
					viewDepth,
					vec2(gid) + 0.5,
					debug.sunShadowFilter,
					false);
			}
		}

		LightSample sun = evaluateDirectional(opaqueSurface, L, sunColor);

		float microVisSun = MicroShadowVisibility(max(sun.NdotL, sun.transNdotL), aoTerm);

		float sunMask    = shadow * microVisSun * contactShadows;
		vec3  sunDiffuse = sun.diffuse * sunMask;
		vec3  direct     = (sun.diffuse + sun.specular) * sunMask;

		LightBuffer lightBuf = getLightBuffer();
		vec3 localLightColor = vec3(0.0);
		vec3 localDiffuse    = vec3(0.0);
		vec3 localSpecular   = vec3(0.0);

		for (uint i = 0u; i < tileLightCount; ++i)
		{
			LocalLight light = lightBuf.lights[sTileLights[i]];

			const bool isFlashLight    = (light.flags & LIGHT_FLAG_FLASHLIGHT) != 0u;
			const bool isFlashLightOff = (light.flags & LIGHT_FLAG_FLASHLIGHT_OFF) != 0u;
			if (isFlashLight && isFlashLightOff) continue;

			LightSample ls = evaluateLocalLight(light, opaqueSurface, scene.cameraPos.xyz);
			if (ls.NdotL <= 0.0 && ls.transNdotL <= 0.0) continue;

			float atten = MicroShadowVisibility(max(ls.NdotL, ls.transNdotL), aoTerm);

			if (isFlashLight && (light.flags & LIGHT_FLAG_CASTS_SPOT_SHADOW) != 0u)
			{
				vec3  toLight = light.position - worldPos;
				float distL   = length(toLight);
				vec3  Lf      = toLight / max(distL, 1e-6);

				vec3  Nf = (dot(geometricNormalWS, Lf) < 0.0) ? -geometricNormalWS : geometricNormalWS;

				float worldTexel = spotWorldTexel(distL, light.outerCos, FLASHLIGHT_TEXEL_SIZE);
				vec3  biasPos    = worldPos + computeNormalOffset(Nf, Lf, worldTexel * FLASHLIGHT_OFFSET_TEXELS);

				vec2  flashUV;
				float flashZ;
				projectToLightSpace(biasPos, scene.flashlightVP, flashUV, flashZ);

				bool inUV = all(greaterThanEqual(flashUV, vec2(0.0)))
						 && all(lessThanEqual(flashUV, vec2(1.0)));

				if (inUV && flashZ >= 0.0 && flashZ <= 1.0)
				{
					float angleScale = 1.0 - saturate(ls.NdotL);
					float bias = MIN_SHADOW_BIAS * (0.25 + angleScale * 0.65);
					atten *= PCFPoissonLow(shadowHash, pc.flashlightShadowMapID,
										   flashUV, flashZ, bias, FLASHLIGHT_TEXEL_SIZE);
				}

				atten *= inUV ? pow(SampleTexture(pc.flashlightCookieTexID, flashUV).r, 2.0) : 0.0;
			}

			localLightColor += (ls.diffuse + ls.specular) * atten;
			localDiffuse    += ls.diffuse * atten;
			localSpecular   += ls.specular * atten;
		}

		bool giOn = (debug.giMode == VBGI) && (scene.temporal.y == 1u);
		vec3 giRadiance = giOn
			? texelFetch(giIndirect, ivec2(gid), 0).rgb * pc.giIntensity
			: vec3(0.0);

		uint envIndex = min(debug.activeEnvMap, MAX_ENV_SETS - 1u);
		vec3 irradianceN = normalize(mix(N, bentWS, bentConf * 0.5));
		vec3 irradiance  = sampleIrradiance(irradianceN, getSHIrradianceBuffer().shIrr[envIndex].sh);

		vec3 ambientDiffuse;
		vec3 ambientSpecular;
		float giSpecBlend = giOn ? saturate((rough - 0.5) * 2.0) : 0.0;

		vec4 rtSpec = vec4(0.0);
		if (DBG(enableRTReflections))
		{
			vec4 packed = SampleReflectionBilateral(
				scene, screenspace_uv, pc.halfTexel, viewDepth, depthTex, rtReflectDenoised);

			vec4 spec = REBLUR_BackEnd_UnpackRadianceAndNormHitDist(packed);

			float fade = 1.0 - smoothstep(
				pc.reflectRoughFade, pc.reflectRoughCutoff, opaqueSurface.rough);

			rtSpec = vec4(spec.rgb, fade);
			specAO = min(specAO, mix(1.0, spec.a, fade));
		}

		evaluateAmbient(ambientDiffuse, ambientSpecular, opaqueSurface,
						irradiance, giRadiance, aoTerm, specAO, giSpecBlend,
						pc.specularID, rtSpec);

		vec3 color = emissive + direct + localLightColor + ambientDiffuse + ambientSpecular;
		imageStore(hdrColor, ivec2(gid), vec4(color, 1.0));

		float glossFactor = rough * rough;
		diffuseRadiance = emissive + sunDiffuse + localDiffuse + ambientDiffuse
						+ (sun.specular * sunMask + localSpecular) * glossFactor;
	}

	sDiffuseRadiance[tid] = vec4(diffuseRadiance, (inBounds && !isSky) ? 1.0 : 0.0);
	barrier();

	if ((gl_LocalInvocationID.x & 1u) == 0u && (gl_LocalInvocationID.y & 1u) == 0u)
	{
		ivec2 halfPix    = ivec2(gid) >> 1;
		ivec2 halfExtent = (ivec2(vpSize) + 1) / 2;

		if (all(lessThan(halfPix, halfExtent)))
		{
			vec4 q = sDiffuseRadiance[tid]
				   + sDiffuseRadiance[tid + 1u]
				   + sDiffuseRadiance[tid + TILE_DIM]
				   + sDiffuseRadiance[tid + TILE_DIM + 1u];

			vec3 avg = (q.w > 0.0) ? q.rgb / q.w : vec3(0.0);
			imageStore(diffuseRadianceHalf, halfPix, vec4(avg * pc.bounceFeedback, 0.0));
		}
	}
}
