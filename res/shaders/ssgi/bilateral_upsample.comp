#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inHiZ;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inBentAOHalf;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D inViewNormals;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D inGIHalf;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outBentAO;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2) writeonly uniform image2D outGI;

layout(push_constant) uniform PushConstantData {
	float effectRadius;
	float effectFalloffRange;
	vec2  ndcToViewMul_x_PixelSize;

	float radiusMultiplier;
	float sampleDistributionPower;
	uint  noiseIndex;
	uint  hilbertLutID;
	float denoiseBlurBeta;

	uint  isFinalPass;
	float upsampleDepthSigma;
	float giClampMax;
	float giReprojTolerance;

	float giTemporalAlpha;
	float giFallbackStrength;
} pc;

void main() {
	SceneData scene    = getSceneData();
	DebugToggles debug = getDebugToggles();

	const ivec2 fullExtent = ivec2(scene.viewportSize.xy);
	const ivec2 fullPix    = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(fullPix, fullExtent))) return;

	const ivec2 fullMax = fullExtent - 1;
	const ivec2 halfMax = (fullExtent + 1) / 2 - 1;
	const ivec2 phase   = aoQuadPhase(scene.temporal.x, debug.aaMode == AA_TAA);

	const float centerZ = texelFetch(inHiZ, fullPix, 0).r;
	const vec3  centerN = octDecode(texelFetch(inViewNormals, fullPix, 0).rg * 2.0 - 1.0);
	const vec3  centerWSN = normalize(mat3(scene.invView) * centerN);

	const vec2  hc   = (vec2(fullPix) - vec2(phase)) * 0.5;
	const ivec2 base = ivec2(floor(hc));
	const vec2  frac = hc - vec2(base);

	vec4  accum   = vec4(0.0);
	vec3  bentSum = vec3(0.0);
	vec3  giSum   = vec3(0.0);
	float wSum    = 0.0;

	float bestW = -1.0;
	vec4  bestS = vec4(centerWSN * 0.5 + 0.5, 1.0);
	vec3  bestG = vec3(0.0);

	const bool giOn = (debug.giMode == VBGI);

	for (int i = 0; i < 4; ++i) {
		ivec2 o       = ivec2(i & 1, i >> 1);
		ivec2 halfPix = clamp(base + o, ivec2(0), halfMax);
		ivec2 srcPix  = min(halfPix * 2 + phase, fullMax);

		float z = texelFetch(inHiZ, srcPix, 0).r;
		vec3  n = octDecode(texelFetch(inViewNormals, srcPix, 0).rg * 2.0 - 1.0);
		vec4  s = texelFetch(inBentAOHalf, halfPix, 0);
		vec3  g = giOn ? texelFetch(inGIHalf, halfPix, 0).rgb : vec3(0.0);

		float bw = max((o.x == 0 ? 1.0 - frac.x : frac.x) *
					   (o.y == 0 ? 1.0 - frac.y : frac.y), 1e-3);

		float dz = abs(z - centerZ) / max(centerZ, 1e-4);
		float nw = pow(saturate(dot(centerN, n)), 8.0);
		float w  = bw * exp2(-dz * pc.upsampleDepthSigma) * nw;

		accum   += s * w;
		bentSum += (s.rgb * 2.0 - 1.0) * w;
		giSum   += g * w;
		wSum    += w;

		if (w > bestW) { bestW = w; bestS = s; bestG = g; }
	}

	vec4 result = (wSum > 1e-5) ? accum / wSum : bestS;
	vec3 gi     = (wSum > 1e-5) ? giSum / wSum : bestG;

	if (dot(bentSum, bentSum) > 1e-8) {
		result.rgb = normalize(bentSum) * 0.5 + 0.5;
	}

	imageStore(outBentAO, fullPix, result);
	imageStore(outGI, fullPix, vec4(gi, 0.0));
}
