#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inGIRaw;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inGIHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D inHiZ;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D inVelocity;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D inPrevDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform sampler2D inViewNormals;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_7) uniform sampler2D inPrevViewNormals;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_8) uniform sampler2D inAORaw;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outGIHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2) writeonly uniform image2D outAO;

layout(push_constant) uniform PushConstantData {
	float effectRadius;
	float effectFalloffRange;
	vec2  ndcToViewMul_x_PixelSize;

	float radiusMultiplier;
	float sampleDistributionPower;
	uint  noiseIndex;
	uint  hilbertLutID;

	float denoiseBlurBeta;
	uint  isFinalPass;

	float upsampleDepthSigma;
	float giClampMax;
	float giReprojTolerance;

	float giTemporalAlpha;
	float giFallbackStrength;
} pc;

const float NORMAL_REJECT_COS = 0.9;

void main() {
	SceneData scene    = getSceneData();
	DebugToggles debug = getDebugToggles();

	const ivec2 fullExtent = ivec2(scene.renderExtentSize.xy);
	const ivec2 fullMax    = fullExtent - 1;
	const ivec2 halfExtent = (fullExtent + 1) / 2;
	const ivec2 halfPix    = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(halfPix, halfExtent))) return;

	const ivec2 phase = aoQuadPhase(scene.temporal.x, IsTAAEnabled());
	const ivec2 pix   = min(halfPix * 2 + phase, fullMax);

	vec3  current   = texelFetch(inGIRaw, halfPix, 0).rgb;
	float currentAO = texelFetch(inAORaw, halfPix, 0).r;

	vec3  nbMin = current;
	vec3  nbMax = current;
	float aoMin = currentAO;
	float aoMax = currentAO;
	for (int y = -1; y <= 1; ++y)
	for (int x = -1; x <= 1; ++x)
	{
		if (x == 0 && y == 0) continue;
		ivec2 p = clamp(halfPix + ivec2(x, y), ivec2(0), halfExtent - 1);
		vec3  s = texelFetch(inGIRaw, p, 0).rgb;
		float a = texelFetch(inAORaw, p, 0).r;
		nbMin = min(nbMin, s);
		nbMax = max(nbMax, s);
		aoMin = min(aoMin, a);
		aoMax = max(aoMax, a);
	}

	bool valid = (scene.temporal.y == 1u);

	vec4 hist = vec4(0.0);

	if (valid)
	{
		const vec2 fullPixelSize = vec2(scene.renderPixelSizes.xy);
		const vec2 halfPixelSize = vec2(scene.renderPixelSizes.zw);
		const vec2 uv            = (vec2(pix) + 0.5) * fullPixelSize;
		const vec2 halfUV        = (vec2(halfPix) + 0.5) * halfPixelSize;

		vec2 velocity   = texelFetch(inVelocity, pix, 0).rg;
		vec2 prevUV     = uv - velocity;
		vec2 prevHalfUV = halfUV - velocity;

		if (any(lessThan(prevUV, vec2(0.0))) || any(greaterThanEqual(prevUV, vec2(1.0))))
		{
			valid = false;
		}
		else
		{
			float centerZ = texelFetch(inHiZ, pix, 0).r;
			vec3  vPos    = cheapReconstructViewPos(uv, centerZ, scene.ndcToViewMult, scene.ndcToViewAdd);
			vec3  posWS   = (scene.invView * vec4(vPos, 1.0)).xyz;

			float expectedZ = -(scene.prevView * vec4(posWS, 1.0)).z;

			float prevRaw = textureLod(inPrevDepth, prevUV, 0.0).r;
			float prevZ   = screenToViewDepth(prevRaw, scene.depthLinearizeMult, scene.depthLinearizeAdd);

			vec3 nCur  = octDecode(texelFetch(inViewNormals, pix, 0).rg * 2.0 - 1.0);
			vec3 nPrev = octDecode(textureLod(inPrevViewNormals, prevUV, 0.0).rg * 2.0 - 1.0);

			vec3 nCurWS  = normalize(mat3(scene.invView) * nCur);
			vec3 nPrevWS = normalize(mat3(scene.prevInvView) * nPrev);
			bool normalOk = dot(nCurWS, nPrevWS) > NORMAL_REJECT_COS;

			bool depthOk  = (prevRaw > 0.0)
						 && abs(prevZ - expectedZ) < expectedZ * pc.giReprojTolerance;

			if (depthOk && normalOk)
			{
				hist = textureLod(inGIHistory, prevUV, 0.0);
				hist.rgb = clamp(hist.rgb, nbMin, nbMax);
			}
			else
			{
				valid = false;
			}
		}
	}

	// Frame count in .a drives a variable rate: alpha=1 on the first sample,
	// annealing to giTemporalAlpha as evidence builds. Fast disocclusion
	// recovery without a fixed slow EMA dragging through fresh regions.
	float histN  = valid ? floor(hist.a)  : 0.0;
	float histAO = valid ? fract(hist.a)  : currentAO;
	histAO = clamp(histAO, aoMin, aoMax);

	float n      = min(histN + 1.0, 1.0 / max(pc.giTemporalAlpha, 1e-4));
	float rate   = 1.0 / n;

	vec3  outRad = mix(hist.rgb, current, rate);
	float outAOv = mix(histAO, currentAO, rate);

	imageStore(outGIHistory, halfPix, vec4(outRad, floor(n) + clamp(outAOv, 0.0, 0.999)));
	imageStore(outAO, halfPix, vec4(outAOv));
}
