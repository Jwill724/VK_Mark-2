#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D rawAO;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D edgeInfo;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D aoFiltered;


layout(push_constant) uniform PushConstantData {
	vec2 tanHalfFov;
	float effectRadius;
	float effectFalloffRange;

	vec2 ndcToViewAdd;
	vec2 ndcToViewMul;

	vec2  ndcToViewMul_x_PixelSize;
	float depthLinearizeMult;
	float depthLinearizeAdd;

	float sharpness;
	float radius;
	vec2  blurDirection;
} pc;

void main()
{
	const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);

	SceneData scene = getSceneData();
	const vec2 fullPixelSize = vec2(scene.pixelSizes.xy);
	vec2 uv = (vec2(pix) + 0.5) * fullPixelSize;

	// center sample
	float centerAO = texture(rawAO, uv).r;
	float centerEdge = texture(edgeInfo, uv).r;

	float sum = 0.0;
	float wsum = 0.0;

	int r = int(pc.radius);
	float sigma = float(r) * 0.5;
	float invTwoSigma2 = 1.0 / (2.0 * sigma * sigma);

	for (int i = -r; i <= r; i++) {
		float offset = float(i);
		vec2 sampleUV = clamp(uv + offset * fullPixelSize * pc.blurDirection, vec2(0.0), vec2(1.0));

		float ao = texture(rawAO, sampleUV).r;
		float edge = texture(edgeInfo, sampleUV).r;

		// Edge-aware weight
		float edgeDiff = abs(edge - centerEdge);
		float edgeWeight = exp(-edgeDiff * pc.sharpness);

		// Gaussian weight
		float spatialWeight = exp(-(offset * offset) * invTwoSigma2);

		float w = spatialWeight * edgeWeight;

		sum += ao * w;
		wsum += w;
	}

	float filteredAO = sum / max(wsum, 1e-5);

	imageStore(aoFiltered, pix, vec4(filteredAO));
}
