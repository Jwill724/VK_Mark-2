#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D rawAO;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_2_TEX) uniform sampler2D edgeInfo;

layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D aoFiltered;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

layout(push_constant) uniform GTAOPush {
	vec2 ndcToViewMul;
	vec2 tanHalfFov;

	vec2 ndcToViewAdd;
	uint sliceCount;
	uint stepsPerSliceCount;

	float effectRadius;
	float radiusMultiplier;
	float effectFalloffRange;
	float sampleDistributionPower;

	float thinOccluderCompensation;
	float depthMipSamplingOffset;
	vec2 ndcToViewMul_x_PixelSize;

	float sharpness;
	float radius;

	vec2 blurDirection;
} pc;

void main()
{
	const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	const vec2 fullPixelSize = vec2(scene.pixelSizes.x, scene.pixelSizes.y);
	vec2 uv = (vec2(pix) + 0.5) * fullPixelSize;

	// center sample
	float centerAO = texture(rawAO, uv).r;
	float centerEdge = texture(edgeInfo, uv).r;

	float sum = 0.0;
	float wsum = 0.0;

	int r = int(pc.radius);
	float sigma = float(r) * 0.5;
	float invTwoSigma2 = 1.0 / (2.0 * sigma * sigma);

	for (int i = -r; i <= r; i++) {
		float offset = float(i);
		vec2 sampleUV = clamp(uv + offset * fullPixelSize * pc.blurDirection, vec2(0.0), vec2(1.0));

		float ao = texture(rawAO, sampleUV).r;
		float edge = texture(edgeInfo, sampleUV).r;

		// Edge-aware weight
		float edgeDiff = abs(edge - centerEdge);
		float edgeWeight = exp(-edgeDiff * pc.sharpness);

		// Gaussian weight
		float spatialWeight = exp(-(offset * offset) * invTwoSigma2);

		float w = spatialWeight * edgeWeight;

		sum += ao * w;
		wsum += w;
	}

	float filteredAO = sum / max(wsum, 1e-5);

	imageStore(aoFiltered, pix, vec4(filteredAO));
}
