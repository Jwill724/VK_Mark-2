#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

// Ideas and most code pulled from here, thanks Will
// https://github.com/Williscool13/WillEngineV2/blob/87a90f41f0486acfd6a589346b919f3bc9629172/shaders/ambient_occlusion/ground_truth/gtao_main_pass.comp

// Original XE_GTAO implementation
// https://github.com/GameTechDev/XeGTAO/blob/master/Source/Rendering/Shaders/XeGTAO.hlsli

// The original GTAO paper
// https://www.iryoku.com/downloads/Practical-Realtime-Strategies-for-Accurate-Indirect-Occlusion.pdf

#include "../include/common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const float GTAO_RADIUS_MULTIPLIER = 1.457;

const uint XE_HILBERT_LEVEL = 6u;
const uint XE_HILBERT_WIDTH = (1u << XE_HILBERT_LEVEL);

// Depth pyramid texture
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform usampler2D inHiZ;

// View space normal texture
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D normal;

// GTAO outputs
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outRawAO;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2) writeonly uniform image2D outEdgeInfo;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_3) writeonly uniform image2D outBentNormals;


layout(push_constant) uniform GTAOPush {
	vec2 ndcToViewMul;
	vec2 tanHalfFov;

	vec2 ndcToViewAdd;
	uint sliceCount;
	uint stepsPerSliceCount;

	float effectRadius;
	float effectFalloffRange;
	float sampleDistributionPower;
	float thinOccluderCompensation;

	vec2 ndcToViewMul_x_PixelSize;
	float depthMipSamplingOffset;
	float constantThickness; // Not in use

	float sharpness;
	float radius;

	vec2 blurDirection;
} pc;

// https://h14s.p5r.org/2012/09/0x5f3759df.html
float fastSqrt(float x) {
	return uintBitsToFloat(0x1fbd1df5 + (floatBitsToUint(x) >> 1));
}

// [-1, 1] -> [0, PI]
float fastAcos(float inX) {
	float x = abs(inX);
	float r = -0.156583 * x + HALF_PI;
	r *= fastSqrt(1.0 - x);

	return (inX >= 0.0) ? r : (PI - r);
}

vec3 reconstructViewPos(vec2 uv, float depthVS) {
	// Cheap mode used by XEGTAO
	vec3 pos;
	pos.xy = (pc.ndcToViewMul * uv + pc.ndcToViewAdd) * depthVS;
	pos.z = -depthVS;
	return pos;
}

vec4 computeEdges(float center, float left, float right, float top, float bottom) {
	vec4 dz = vec4(left, right, top, bottom) - vec4(center);

	float slopeLR = 0.5 * (dz.y - dz.x);
	float slopeTB = 0.5 * (dz.w - dz.z);

	vec4 dz2 = dz + vec4(slopeLR, -slopeLR, slopeTB, -slopeTB);
	dz = min(abs(dz), abs(dz2));

	return clamp((1.25 - dz / (center * 0.011)), 0.0, 1.0);
}

// 2 bits per edge mean 4 gradient values (0, 0.33, 0.66, 1) for smoother transitions!
float packEdges(vec4 edges)
{
	edges = round(clamp(edges, 0, 1) * 2.9);
	return dot(edges, vec4(64.0 / 255.0, 16.0 / 255.0, 4.0 / 255.0, 1.0 / 255.0));
}

vec2 getNoise(ivec2 pix) {
	vec2 pixel = vec2(pix);
	float sliceNoise = interleavedGradientNoise(pixel);
	float stepNoise = interleavedGradientNoise(pixel.yx + vec2(17.0, 43.0));
	return vec2(sliceNoise, stepNoise);
}

uint XE_GTAO_HilbertIndex(uint posX, uint posY) {
	uint index = 0u;
	for (uint curLevel = XE_HILBERT_WIDTH / 2u; curLevel > 0u; curLevel /= 2u) {
		uint regionX = (posX & curLevel) > 0u ? 1u : 0u;
		uint regionY = (posY & curLevel) > 0u ? 1u : 0u;
		index += curLevel * curLevel * ((3u * regionX) ^ regionY);
		if (regionY == 0u) {
			if (regionX == 1u) {
				posX = uint(XE_HILBERT_WIDTH - 1u) - posX;
				posY = uint(XE_HILBERT_WIDTH - 1u) - posY;
			}

			uint temp = posX;
			posX = posY;
			posY = temp;
		}
	}
	return index;
}

vec2 XE_GTAO_SpatioTemporalNoise(ivec2 pixCoord, uint temporalIndex) {
	uint index = XE_GTAO_HilbertIndex(uint(pixCoord.x), uint(pixCoord.y));
	index += 288u * (temporalIndex % 64u);
	return vec2(fract(0.5 + index * vec2(0.75487766624669276005, 0.5698402909980532659114)));
}

void main()
{
	const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	SceneData scene = getSceneData();
	if (pix.x >= int(scene.viewportSize.x) || pix.y >= int(scene.viewportSize.y)) return;
	const vec2 fullPixelSize = vec2(scene.pixelSizes.x, scene.pixelSizes.y);
	vec2 uv = (vec2(pix) + 0.5) * fullPixelSize;

	vec2 gatherCenter = vec2(pix) * fullPixelSize;
	uvec4 UL = textureGather(inHiZ, gatherCenter, 0);
	uvec4 BR = textureGatherOffset(inHiZ, gatherCenter, ivec2(1, 1), 0);

	// In view space
	float centerRaw = unpackNearRaw(UL.y);
	float leftRaw   = unpackNearRaw(UL.x);
	float topRaw    = unpackNearRaw(UL.z);
	float rightRaw  = unpackNearRaw(BR.z);
	float botRaw    = unpackNearRaw(BR.x);

	float centerZ       = linearizeDepth(centerRaw, scene.cameraClips.x, scene.cameraClips.y);
	const float leftZ   = linearizeDepth(leftRaw,   scene.cameraClips.x, scene.cameraClips.y);
	const float topZ    = linearizeDepth(topRaw,    scene.cameraClips.x, scene.cameraClips.y);
	const float rightZ  = linearizeDepth(rightRaw,  scene.cameraClips.x, scene.cameraClips.y);
	const float botZ    = linearizeDepth(botRaw,    scene.cameraClips.x, scene.cameraClips.y);

	DebugToggles debug = getDebugToggles();

	// Edge detection
	vec4 edges = computeEdges(centerZ, leftZ, rightZ, topZ, botZ);
	float packed = packEdges(edges);
	imageStore(outEdgeInfo, pix, vec4(packed));

	// View space normals
	vec3 N = normalize(texture(normal, uv).rgb * 2.0 - 1.0);

	// Per Intel: Moves center pixel a bit to avoid imprecision artifacts.
	centerZ *= 0.99920;

//	float depthVS = centerZ;
//	// Depth fade for GTAO
//	float depthFade = 500.0;
//	float maxDepth = 1000.0;
//	float fadeStart = maxDepth * 0.9;
//	// start fading at 90% of range
//	if (depthVS > fadeStart) {
//		float t = clamp((depthVS - fadeStart) / (maxDepth - fadeStart), 0.0, 1.0);
//		depthFade = 1.0 - t;
//		if (depthFade <= 0.0) {
//			// Completely outside GTAO range: no occlusion
//			imageStore(outRawAO, pix, vec4(1.0));
//			imageStore(outBentNormals, pix, vec4(N, 1.0));
//			return;
//		}
//	}

	// Reconstruct view space pos
	vec3 vPos = reconstructViewPos(uv, centerZ);
	vec3 viewVec = normalize(-vPos);

	// GTAO sampling parameters
	const float effectRadius = pc.effectRadius * GTAO_RADIUS_MULTIPLIER;
	const float falloffRange = pc.effectFalloffRange * effectRadius;
	const float falloffFrom = effectRadius * (1.0 - pc.effectFalloffRange);

	const float falloffMul = -1.0 / falloffRange;
	const float falloffAdd = falloffFrom / falloffRange + 1.0;

	// noise
	vec2 noise;
	if (debug.aaMode == AA_TAA) {
		noise = XE_GTAO_SpatioTemporalNoise(pix, scene.temporal.x);
	}
	else {
		noise = getNoise(pix);
	}

	const float noiseSlice = noise.x;
	const float noiseSample = noise.y;

	const vec2 pixelDirRBViewSpaceSizeAtCenterZ = vec2(centerZ) * pc.ndcToViewMul_x_PixelSize;

	float screenspaceRadius = effectRadius / pixelDirRBViewSpaceSizeAtCenterZ.x;

	// Raidus too small -> early exits
	const float pixelTooCloseThreshold = 1.3;

	float visibility = 0.0;
	visibility += clamp((10.0 - screenspaceRadius) / 100.0, 0.0, 1.0) * 0.5;

	if (screenspaceRadius < pixelTooCloseThreshold) {
		visibility = clamp(visibility, 0.0, 1.0);

		imageStore(outRawAO, pix, vec4(visibility));
		imageStore(outBentNormals, pix, vec4(N, 1.0));
		return;
	}

	// Minimal sample offset to avoid sampling center
	const float minS = pixelTooCloseThreshold / screenspaceRadius;

	// GTAO bent normals for the average direction and spread of unoccluded space
	vec3 bentNormal = vec3(0.0);
	float bentConeAngleAccum = 0.0;

	// Define hemisphere slices for outer loop
	const float sliceCount = float(pc.sliceCount);
	const float stepsPerSlice = float(pc.stepsPerSliceCount);
	for (float slice = 0.0; slice < sliceCount; slice++) {
		float sliceK = (slice + noiseSlice) / sliceCount;

		// Slice direction angle
		float phi = sliceK * PI;
		float cosPhi = cos(phi);
		float sinPhi = sin(phi);

		vec2 omega = vec2(cosPhi, -sinPhi) * screenspaceRadius;
		const vec3 dirVec = vec3(cosPhi, sinPhi, 0.0);

		// Orthogonal projection basis
		const vec3 orthoDirVec = dirVec - (dot(dirVec, viewVec) * viewVec);
		const vec3 axisVec = normalize(cross(orthoDirVec, viewVec));

		vec3 projectedNormalVec = N - axisVec * dot(N, axisVec);
		float signNorm = sign(dot(orthoDirVec, projectedNormalVec));

		float projectedNormalLength = length(projectedNormalVec);
		projectedNormalLength = max(projectedNormalLength, 1e-6);
		float cosNorm = clamp(dot(projectedNormalVec, viewVec) / projectedNormalLength, 0.0, 1.0);

		float n = signNorm * fastAcos(cosNorm);

		const float lowHorizonCos0 = cos(n + HALF_PI);
		const float lowHorizonCos1 = cos(n - HALF_PI);

		float horizonCos0 = lowHorizonCos0;
		float horizonCos1 = lowHorizonCos1;

		// Inner loop ray march along slice direction
		for (float step = 0.0; step < stepsPerSlice; step++) {
			// R1 quasi-random progression
			const float stepBaseNoise = (slice + step * stepsPerSlice) * 0.61803398874989484;

			float stepNoise = fract(noiseSample + stepBaseNoise);

			float s = (step + stepNoise) / stepsPerSlice;
			s = pow(s, pc.sampleDistributionPower);

			// Avoids sampling middle pixel
			s += minS;

			vec2 sampleOffset = s * omega;
			float sampleOffsetLength = length(sampleOffset);

			// Snap pixel to center to avoid artifacts
			sampleOffset = round(sampleOffset) * fullPixelSize;

			// Sample + opposite sample
			vec2 sampleScreenPos0 = uv + sampleOffset;
			vec2 sampleScreenPos1 = uv - sampleOffset;

			// Selected mip level in depth pyramid
			const float mipLevel = clamp(
				log2(sampleOffsetLength) - pc.depthMipSamplingOffset,
				0.0,
				float(HI_Z_MIP_COUNT - 1u)
			);

			// Two depth sample positions
			uvec4 sample0 = textureLod(inHiZ, sampleScreenPos0, mipLevel);
			uvec4 sample1 = textureLod(inHiZ, sampleScreenPos1, mipLevel);

			float nearRaw0 = unpackNearRaw(sample0.r);
			float nearRaw1 = unpackNearRaw(sample1.r);

			float SZ0 = linearizeDepth(nearRaw0, scene.cameraClips.x, scene.cameraClips.y);
			float SZ1 = linearizeDepth(nearRaw1, scene.cameraClips.x, scene.cameraClips.y);

			vec3 samplePos0 = reconstructViewPos(sampleScreenPos0, SZ0);
			vec3 samplePos1 = reconstructViewPos(sampleScreenPos1, SZ1);

			vec3 delta0 = samplePos0 - vPos;
			vec3 delta1 = samplePos1 - vPos;

			float dist0 = length(delta0);
			float dist1 = length(delta1);

			vec3 horizonVec0 = delta0 / dist0;
			vec3 horizonVec1 = delta1 / dist1;

			// Sample horizon cos
			float shc0 = dot(horizonVec0, viewVec);
			float shc1 = dot(horizonVec1, viewVec);

			// Thickness heuristic
			float falloffBase0 = length(vec3(delta0.x, delta0.y, delta0.z * (1.0 + pc.thinOccluderCompensation)));
			float falloffBase1 = length(vec3(delta1.x, delta1.y, delta1.z * (1.0 + pc.thinOccluderCompensation)));
			float weight0 = clamp(falloffBase0 * falloffMul + falloffAdd, 0.0, 1.0);
			float weight1 = clamp(falloffBase1 * falloffMul + falloffAdd, 0.0, 1.0);

			// Discard unwanted samples
			shc0 = mix(lowHorizonCos0, shc0, weight0);
			shc1 = mix(lowHorizonCos1, shc1, weight1);

			horizonCos0 = max(horizonCos0, shc0);
			horizonCos1 = max(horizonCos1, shc1);
		}

		// Slant correction hack
		projectedNormalLength = mix(projectedNormalLength, 1.0, 0.05);

		// Integrate visibility from horizon angles
		float h0 = -fastAcos(horizonCos1);
		float h1 = fastAcos(horizonCos0);
		float iarc0 = (cosNorm + 2.0 * h0 * sin(n) - cos(2.0 * h0 - n)) / 4.0;
		float iarc1 = (cosNorm + 2.0 * h1 * sin(n) - cos(2.0 * h1 - n)) / 4.0;
		float localVisibility = projectedNormalLength * (iarc0 + iarc1);
		visibility += localVisibility;

		// Bent normals integration
		float t0 = (6.0 * sin(h0 - n)
			- sin(3.0 * h0 - n)
			+ 6.0 * sin(h1 - n)
			- sin(3.0 * h1 - n)
			+ 16.0 * sin(n)
			- 3.0 * (sin(h0 + n) + sin(h1 + n))) / 12.0;

		float t1 = (-cos(3.0 * h0 - n)
			- cos(3.0 * h1 - n)
			+ 8.0 * cos(n)
			- 3.0 * (cos(h0 + n) + cos(h1 + n))) / 12.0;

		vec3 localBentNormal = normalize(orthoDirVec) * t0 - viewVec * t1;
		localBentNormal *= projectedNormalLength;
		bentNormal += localBentNormal;

		// Cone half-angle for this slice = average unoccluded arc half-width
		float sliceHalfArc = 0.5 * ((h1 - n) + (-(h0) + n));
		bentConeAngleAccum += max(sliceHalfArc, 0.0);
	}

	// Normalize
	visibility /= sliceCount;

	visibility = pow(visibility, 2.2);
	visibility = max(0.03, visibility);
	visibility = clamp(visibility, 0.0, 1.0);

	float coneAngle = bentConeAngleAccum / sliceCount;
	bentNormal = normalize(bentNormal);
	imageStore(outBentNormals, pix, vec4(bentNormal, coneAngle));

	imageStore(outRawAO, pix, vec4(visibility));
}
