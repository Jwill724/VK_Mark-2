#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"
#include "../include/depth.glsl"

// Learning resources
// https://learnopengl.com/Advanced-Lighting/SSAO
// https://ajweeks.com/blog/2019/05/11/SSAO/
// https://www.youtube.com/watch?v=xq5hD4RGcYw&t=107s
// https://www.youtube.com/watch?v=g4or1fDadqk&t=448s

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

// Sample kernel
const uint KERNEL_SIZE = 128u;
layout(set = GLOBAL_SET, binding = GLOBAL_BINDING_SSAO_KERNEL) uniform KernelUBO {
	vec4 samples[KERNEL_SIZE]; // pre-generated hemisphere samples
} kernel;

layout(push_constant) uniform SSAOPush {
	vec2 screenSize;
	vec2 invScreenSize;

	float aoRadius;
	float bias;
	float intensity;
	int blurRadius;

	vec2 blurDirection;
	uint sampleCount;
	float pad0;
} pc;

// Depth texture
layout(set = PUSH_SET, binding = PUSH_BINDING_DEPTH_TEX) uniform sampler2D depthTex;

// Normal texture
layout(set = PUSH_SET, binding = PUSH_BINDING_NORMAL_TEX) uniform sampler2D normalTex;

// Noise texture
layout(set = PUSH_SET, binding = PUSH_BINDING_NOISE_TEX) uniform sampler2D noiseTex;

// SSAO output (R8_UNORM)
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D ssaoOut;

void main()
{
	ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	if (pix.x >= int(pc.screenSize.x) || pix.y >= int(pc.screenSize.y)) return;

	vec2 uv = (vec2(pix) + 0.5) * pc.invScreenSize;

	// === Depth ===
	float depth = texture(depthTex, uv).r;
	if (depth <= DEPTH_EPSILON_REVERSED_Z) {
		imageStore(ssaoOut, pix, vec4(1.0, 0.0, 0.0, 1.0));
		return;
	}

	ViewReconstructResult center = reconstructViewSpaceFromDepth(
		uv,
		depth,
		scene.invProj
	);
	vec3 posVS = center.pos;
	float centerDepth = center.viewDepth;

	// === Normal (view space) ===
	vec3 normal = normalize(texture(normalTex, uv).rgb * 2.0 - 1.0);

	// === Noise ===
	vec2 noiseUV = uv * (pc.screenSize / 4.0);
	vec2 noiseSample = texture(noiseTex, noiseUV).rg;
	vec3 randomVec = normalize(vec3(noiseSample, 0.0));

	// Build tangent basis in view space
	vec3 tangent   = normalize(randomVec - normal * dot(randomVec, normal));
	vec3 bitangent = cross(normal, tangent);
	mat3 TBN       = mat3(tangent, bitangent, normal);

	float radius    = pc.aoRadius;
	float occlusion = 0.0;

	uint sampleCount = min(pc.sampleCount, KERNEL_SIZE);

	for (uint i = 0u; i < sampleCount; ++i) {
		vec3 samplePos = posVS + (TBN * kernel.samples[i].xyz) * radius;

		// project from view -> clip -> uv
		vec4 offset = scene.proj * vec4(samplePos, 1.0);
		offset.xyz /= offset.w;

		vec2 sampleUV = offset.xy * 0.5 + 0.5;
		sampleUV.y = 1.0 - sampleUV.y;

		if (sampleUV.x < 0.0 || sampleUV.x > 1.0 ||
			sampleUV.y < 0.0 || sampleUV.y > 1.0)
			continue;

		float sampleDepth = texture(depthTex, sampleUV).r;
		if (sampleDepth <= DEPTH_EPSILON_REVERSED_Z) continue;

		ViewReconstructResult sampleSurf = reconstructViewSpaceFromDepth(
			sampleUV,
			sampleDepth,
			scene.invProj
		);
		float geomDepth = sampleSurf.viewDepth;
		float expectedZ = -samplePos.z; // positive view-space depth

		// Is there geometry is front of that sample point along the ray?
		float isOccluder = (geomDepth <= expectedZ - pc.bias) ? 1.0 : 0.0;

		// Distance based falloff
		float rangeCheck = smoothstep(0.0, 1.0, radius / abs(centerDepth - geomDepth));

		occlusion += isOccluder * rangeCheck;
	}

	occlusion = 1.0 - (occlusion / float(sampleCount));
	occlusion = clamp(occlusion, 0.0, 1.0);
	occlusion = mix(1.0, occlusion, pc.intensity);

	imageStore(ssaoOut, pix, vec4(occlusion, 0.0, 0.0, 1.0));
}