#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/set_bindings.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform SSAOPush {
	vec2 screenSize;
	vec2 invScreenSize;
	float aoRadius;
	float bias;
	float intensity;
	int blurRadius;
	vec2 blurDirection;
	uint sampleCount;
	float pad0;
} pc;

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D ssaoInput;
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D blur;

void main() {
	ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	vec2 uv = (vec2(pix) + 0.5) * pc.invScreenSize;

	float result = 0.0;
	float weightSum = 0.0;

	// Gaussian blur
	for (int i = -pc.blurRadius; i <= pc.blurRadius; i++) {
		vec2 offset = pc.blurDirection * float(i) * pc.invScreenSize;
		float ssaoSample = texture(ssaoInput, uv + offset).r;

		float weight = exp(-0.5 * (i * i) / float(pc.blurRadius * pc.blurRadius));
		result += ssaoSample * weight;
		weightSum += weight;
	}

	result /= weightSum;

	imageStore(blur, pix, vec4(result, 0.0, 0.0, 1.0));
}