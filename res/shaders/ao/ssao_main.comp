#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

// Core xegtao glsl implementation guideline, thanks Will
// https://github.com/Williscool13/WillEngineV2/blob/87a90f41f0486acfd6a589346b919f3bc9629172/shaders/ambient_occlusion/ground_truth/gtao_main_pass.comp

// Original XE_GTAO implementation
// https://github.com/GameTechDev/XeGTAO/blob/master/Source/Rendering/Shaders/XeGTAO.hlsli

// The original GTAO paper
// https://www.iryoku.com/downloads/Practical-Realtime-Strategies-for-Accurate-Indirect-Occlusion.pdf

// Visibility bitmask ambient occlusion paper
// https://arxiv.org/pdf/2301.11376

// Visibility bitfield functions
// Provided from Spartan Engine
// https://github.com/PanosK92/SpartanEngine/blob/master/data/shaders/ssao.hlsl

// Shader assumes reversed z depth
// "depth" header is only needed for Hi-Z mip count, which is set to 5

// TAA "required" to clean up noise and halo

#include "../include/common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const float GTAO_DEPTH_MIP_SAMPLING_OFFSET       = 3.3;

const uint  SLICE_COUNT                          = 3u;
const uint  STEPS_PER_SLICE                      = 6u;

const uint  SECTOR_COUNT                         = 32u;
const float CONSTANT_THICKNESS                   = 0.2;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inHiZ;                // XeGTAO prefiltered Hi-Z, already linearized
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inViewSpaceNormals;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outRawAO;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2) writeonly uniform image2D outEdgeInfo;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_3) writeonly uniform image2D outBentNormals;

layout(push_constant) uniform PushConstantData {
	vec2 tanHalfFov;                  // (1.0 / proj[0][0], 1.0 / proj[1][1])
	float effectRadius;               // 0.5
	float effectFalloffRange;         // 0.6

	vec2 ndcToViewAdd;                // (tanHalfFov.x * 2.0, tanHalfFov.y * -2.0)
	vec2 ndcToViewMul;                // (tanHalfFov.x * -1.0, tanHalfFov.y * 1.0)

	vec2  ndcToViewMul_x_PixelSize;   // ndcToViewMul * (1 / fullscreen.xy)
	float depthLinearizeMult;         // -proj[3][2]
	float depthLinearizeAdd;          // proj[2][2];

	// Bilateral blur
	float sharpness;                  // 2.0
	float radius;                     // 4.0
	vec2  blurDirection;              // H(1,0) / V(0,1)

	uint noiseIndex;                  // frameIndex % 64
	uint hilbertLutID;                // precomputed noise texture

	// Denoise
	float denoiseBlurBeta;            // 1.2
	uint isFinalPass;                 // 0: first, 1: last
} pc;

// https://h14s.p5r.org/2012/09/0x5f3759df.html
float fastSqrt(float x) {
	return uintBitsToFloat(0x1fbd1df5 + (floatBitsToUint(x) >> 1));
}

// [-1, 1] -> [0, PI]
float fastAcos(float inX) {
	float x = abs(inX);
	float r = -0.156583 * x + HALF_PI;
	r *= fastSqrt(1.0 - x);

	return (inX >= 0.0) ? r : (PI - r);
}

vec3 cheapReconstructViewSpacePosition(vec2 uv, float depthVS) {
	vec3 pos;
	pos.xy = (pc.ndcToViewMul * uv + pc.ndcToViewAdd) * depthVS;
	pos.z = -depthVS;
	return pos;
}

vec4 computeEdges(float center, float left, float right, float top, float bottom) {
	vec4 dz = vec4(left, right, top, bottom) - vec4(center);

	float slopeLR = 0.5 * (dz.y - dz.x);
	float slopeTB = 0.5 * (dz.w - dz.z);

	vec4 dz2 = dz + vec4(slopeLR, -slopeLR, slopeTB, -slopeTB);
	dz = min(abs(dz), abs(dz2));
	return saturate((1.25 - dz / (center * 0.011)));
}

// 2 bits per edge mean 4 gradient values (0, 0.33, 0.66, 1) for smoother transitions!
float packEdges(vec4 edges) {
	edges = round(clamp(edges, 0, 1) * 2.9);
	return dot(edges, vec4(64.0 / 255.0, 16.0 / 255.0, 4.0 / 255.0, 1.0 / 255.0));
}

vec2 XE_GTAO_SpatioTemporalNoise(ivec2 pixCoord) {
	uint index = SampleTexelFetch(pc.hilbertLutID, ivec2(pixCoord % 64), 0).r;
	index += 288u * (pc.noiseIndex);
	return vec2(fract(0.5 + index * vec2(0.75487766624669276005, 0.5698402909980532659114)));
}

vec2 fastAcos2(vec2 x) {
	return (-0.69813170 * x * x - 0.87266463) * x + 1.57079633;
}

// https://www.youtube.com/watch?v=g4or1fDadqk&t=29s (end of VBAO section)
// Cool trick to warp the horizon angle to approximate the cosine weighted integral
float cosineWarp(float x) {
	return 0.5 - 0.5 * cos(PI * x);
}

uint updateSectors(float minHorizon, float maxHorizon, uint globalOccludedbitmask) {
	float warpedMin = cosineWarp(minHorizon);
	float warpedMax = cosineWarp(maxHorizon);

	// convert horizon angles to bitmask
	uint startHorizonInt        = uint(warpedMin * SECTOR_COUNT);
	float angleHorizon          = (warpedMax - warpedMin) * SECTOR_COUNT;
	uint angleHorizonInt        = uint(ceil(angleHorizon));
	uint angleHorizonbitmask    = angleHorizonInt > 0 ? (0xFFFFFFFFu >> (SECTOR_COUNT - angleHorizonInt)) : 0u;
	uint currentOccludedbitmask = angleHorizonbitmask << startHorizonInt;
	return globalOccludedbitmask | currentOccludedbitmask;
}

vec2 getFrontBackHorizons(float samplingDirection, vec3 deltaPos, vec3 viewVec, float n) {
	// compute horizon angles for front and back faces
	samplingDirection     = -samplingDirection;
	vec3 deltaPosBackface = deltaPos - viewVec * CONSTANT_THICKNESS;
	vec2 frontBackHorizon = vec2(dot(normalize(deltaPos), viewVec), dot(normalize(deltaPosBackface), viewVec));
	frontBackHorizon      = fastAcos2(frontBackHorizon);
	frontBackHorizon      = saturate((samplingDirection * -frontBackHorizon - n + HALF_PI) / PI);
	frontBackHorizon      = samplingDirection >= 0.0 ? frontBackHorizon.yx : frontBackHorizon.xy;

	return frontBackHorizon;
}

void main() {
	const ivec2 pix           = ivec2(gl_GlobalInvocationID.xy);
	SceneData scene           = getSceneData();
	DebugToggles debug        = getDebugToggles();
	const vec2 fullScreenSize = vec2(scene.viewportSize.xy);
	if (pix.x >= int(fullScreenSize.x) || pix.y >= int(fullScreenSize.y)) return;

	const vec2 fullPixelSize = vec2(scene.pixelSizes.xy);
	const vec2 uv            = (vec2(pix) + 0.5) * fullPixelSize;

	vec2 gatherCenter = vec2(pix) * fullPixelSize;
	vec4 UL           = textureGather(inHiZ, gatherCenter, 0);
	vec4 BR           = textureGatherOffset(inHiZ, gatherCenter, ivec2(1), 0);

	// Prefiltered linearized xegtao min Hi Z
	float centerZ       = UL.y;
	const float leftZ   = UL.x;
	const float rightZ  = UL.z;
	const float topZ    = BR.z;
	const float botZ    = BR.x;

	// Edge detection
	vec4  edges  = computeEdges(centerZ, leftZ, rightZ, topZ, botZ);
	float packed = packEdges(edges);
	imageStore(outEdgeInfo, pix, vec4(packed));

	// View space normal
	const vec3 N = normalize(texture(inViewSpaceNormals, uv).rgb * 2.0 - 1.0);

	// Per Intel: Moves center pixel a bit to avoid imprecision artifacts.
	centerZ *= 0.99999; // Good for d32

	// Fade ao output
	float depthVS         = centerZ;
	float depthFade       = 50.0;
	const float maxDepth  = 150.0;
	const float fadeStart = maxDepth * 0.9;
	// start fading at 90% of range
	if (depthVS > fadeStart) {
		float t = saturate((depthVS - fadeStart) / (maxDepth - fadeStart));
		depthFade = 1.0 - t;
		if (depthFade <= 0.0) {
			// Completely outside AO range
			imageStore(outRawAO, pix, vec4(1.0));
			imageStore(outBentNormals, pix, vec4(N, 1.0));
			return;
		}
	}

	// Reconstruct view space pos
	vec3 vPos    = cheapReconstructViewSpacePosition(uv, centerZ);
	vec3 viewVec = normalize(-vPos);

	// GTAO sampling parameters
	float effectRadius = pc.effectRadius * GTAO_RADIUS_MULTIPLIER;
	float falloffRange = pc.effectFalloffRange * effectRadius;
	float falloffFrom  = effectRadius * (1.0 - pc.effectFalloffRange);

	const float falloffMul = -1.0 / falloffRange;
	const float falloffAdd = falloffFrom / falloffRange + 1.0;

	// Pre-computed hilbert curve lut
	vec2  noise       = XE_GTAO_SpatioTemporalNoise(pix);
	float noiseSlice  = noise.x;
	float noiseSample = noise.y;

	const vec2 pixelDirRBViewSpaceSizeAtCenterZ = vec2(centerZ) * pc.ndcToViewMul_x_PixelSize;
	float screenspaceRadius                     = pc.effectRadius / pixelDirRBViewSpaceSizeAtCenterZ.x;

	// Raidus too small -> early exits
	const float pixelTooCloseThreshold = 1.3;

	// Minimal sample offset to avoid sampling center
	const float minS = pixelTooCloseThreshold / screenspaceRadius;

	bool bentNormalsOn = (debug.aoMode == AO_VBAO_BENT_NORMALS);

	// GTAO bent normals for the average direction and spread of unoccluded space
	vec3  bentNormal         = vec3(0.0);
	float bentConeAngleAccum = 0.0;

	float visibility = 0.0;

	// Define hemisphere slices for outer loop
	for (uint slice = 0u; slice < SLICE_COUNT; slice++) {
		// Slice direction angle
		float sliceK                = (float(slice) + noiseSlice) / float(SLICE_COUNT);
		float phi                   = sliceK * PI;
		float cosPhi                = cos(phi);
		float sinPhi                = sin(phi);
		vec2 omega                  = vec2(cosPhi, -sinPhi) * screenspaceRadius;
		const vec3 dirVec           = vec3(cosPhi, sinPhi, 0.0);

		// Orthogonal projection basis
		const vec3 orthoDirVec      = dirVec - dot(dirVec, viewVec) * viewVec;
		const vec3 axisVec          = normalize(cross(orthoDirVec, viewVec));
		vec3 projectedNormalVec     = N - axisVec * dot(N, axisVec);
		float projectedNormalLength = length(projectedNormalVec);
		projectedNormalLength       = max(projectedNormalLength, 1e-6);
		float cosNorm               = saturate(dot(projectedNormalVec, viewVec) / projectedNormalLength);
		float signNorm              = sign(dot(orthoDirVec, projectedNormalVec));
		float n                     = signNorm * fastAcos(cosNorm);

		uint occlusionBitmask       = 0u;

		float lowHorizonCos0;
		float lowHorizonCos1;
		float horizonCos0;
		float horizonCos1;
		if (bentNormalsOn) {
			// Horizon logic
			lowHorizonCos0 = cos(n + HALF_PI);
			lowHorizonCos1 = cos(n - HALF_PI);
			horizonCos0    = lowHorizonCos0;
			horizonCos1    = lowHorizonCos1;
		}

		// Inner loop ray march along slice direction
		for (uint step = 0u; step < STEPS_PER_SLICE; step++) {
			// R1 sequence (http://extremelearning.com.au/unreasonable-effectiveness-of-quasirandom-sequences/)
			const float stepBaseNoise = float(slice + step * STEPS_PER_SLICE) * 0.6180339887498948482; // <- this should unroll
			float stepNoise           = fract(noiseSample + stepBaseNoise);
			float s                   = (float(step) + stepNoise) / float(STEPS_PER_SLICE);
			s                        += minS; // Avoids sampling middle pixel

			// Sample position
			vec2 sampleOffset         = s * omega;
			float sampleOffsetLength  = length(sampleOffset);

			// Snap pixel to center to avoid artifacts
			sampleOffset              = round(sampleOffset) * fullPixelSize;

			// Selected mip level in depth pyramid
			const float mipLevel      = clamp(log2(sampleOffsetLength) - GTAO_DEPTH_MIP_SAMPLING_OFFSET, 0.0, HI_Z_MIP_CLAMPED);

			vec2 sampleScreenPos0     = uv + sampleOffset;
			float SZ0                 = textureLod(inHiZ, sampleScreenPos0, mipLevel).r;
			vec3 samplePos0           = cheapReconstructViewSpacePosition(sampleScreenPos0, SZ0);
			vec3 delta0               = samplePos0 - vPos;

			vec2 sampleScreenPos1     = uv - sampleOffset;
			float SZ1                 = textureLod(inHiZ, sampleScreenPos1, mipLevel).r;
			vec3 samplePos1           = cheapReconstructViewSpacePosition(sampleScreenPos1, SZ1);
			vec3 delta1               = samplePos1 - vPos;

			// Update bitmasks
			vec2 fbh0                 = getFrontBackHorizons(1.0, delta0, viewVec, n);
			occlusionBitmask          = updateSectors(fbh0.x, fbh0.y, occlusionBitmask);

			vec2 fbh1                 = getFrontBackHorizons(-1.0, delta1, viewVec, n);
			occlusionBitmask          = updateSectors(fbh1.x, fbh1.y, occlusionBitmask);

			if (bentNormalsOn) {
				// Horizon angles
				float dist0        = length(delta0);
				vec3 horizonVec0   = delta0 / dist0;

				float dist1        = length(delta1);
				vec3 horizonVec1   = delta1 / dist1;

				// Sample weights
				float weight0      = saturate(dist0 * falloffMul + falloffAdd);
				float weight1      = saturate(dist1 * falloffMul + falloffAdd);

				// Sample horizon cos
				float shc0         = dot(horizonVec0, viewVec);
				float shc1         = dot(horizonVec1, viewVec);

				// Discard unwanted samples
				shc0               = mix(lowHorizonCos0, shc0, weight0);
				shc1               = mix(lowHorizonCos1, shc1, weight1);

				horizonCos0        = max(horizonCos0, shc0);
				horizonCos1        = max(horizonCos1, shc1);
			}
		}

		visibility += (1.0 - float(bitCount(occlusionBitmask)) / float(SECTOR_COUNT));

		if (bentNormalsOn) {
			// Slant correction hack
			projectedNormalLength  = mix(projectedNormalLength, 1.0, 0.05);

			// Compute horizon angles
			float h0 = -fastAcos(horizonCos1);
			float h1 = fastAcos(horizonCos0);

			// Bent normals integration
			float t0 = (6.0 * sin(h0 - n)
				- sin(3.0 * h0 - n)
				+ 6.0 * sin(h1 - n)
				- sin(3.0 * h1 - n)
				+ 16.0 * sin(n)
				- 3.0 * (sin(h0 + n) + sin(h1 + n))) / 12.0;

			float t1 = (-cos(3.0 * h0 - n)
				- cos(3.0 * h1 - n)
				+ 8.0 * cos(n)
				- 3.0 * (cos(h0 + n) + cos(h1 + n))) / 12.0;

			vec3 localBentNormal = normalize(orthoDirVec) * t0 - viewVec * t1;
			localBentNormal     *= projectedNormalLength;
			bentNormal          += localBentNormal;

			// Cone half-angle for this slice = average unoccluded arc half-width
			float sliceHalfArc  = 0.5 * ((h1 - n) + (-(h0) + n));
			bentConeAngleAccum += max(sliceHalfArc, 0.0);
		}
	}

	// Normalize
	visibility /= float(SLICE_COUNT);
	imageStore(outRawAO, pix, vec4(visibility));

	if (bentNormalsOn) {
		// Convert view space bent normals to world space
		bentNormal = normalize(bentNormal);
		vec3 worldSpaceBent = normalize(mat3(scene.invView) * bentNormal);

		float coneAngle = bentConeAngleAccum / float(SLICE_COUNT);
		imageStore(outBentNormals, pix, vec4(worldSpaceBent, coneAngle));
	}
}
