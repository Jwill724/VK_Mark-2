#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/set_bindings.glsl"
#include "../include/gpu_scene_structures.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_1_TEX) uniform sampler2D inCurDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_2_TEX) uniform sampler2D inNormalVS;
layout(set = PUSH_SET, binding = PUSH_BINDING_INPUT_3_TEX) uniform sampler2D inAOHalf;

layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D outAOFull;

float depthWeightLinear(float centerZ, float sampleZ)
{
    float dz = abs(sampleZ - centerZ);

    if (dz > 0.25) return 0.0;

    return exp(-dz * 12.0);
}

float normalWeightExp(vec3 centerNormal, vec3 sampleNormal)
{
    float nd = max(dot(centerNormal, sampleNormal), 0.0);
    return exp(-(1.0 - nd) * 16.0);
}

void main()
{
    ivec2 fullPix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 fullRes = ivec2(scene.viewportSize.xy);

    if (fullPix.x >= fullRes.x || fullPix.y >= fullRes.y) return;

    ivec2 halfRes = (fullRes + ivec2(1)) >> 1;

    // Full-res center
    float centerDepth01 = texelFetch(inCurDepth, fullPix, 0).r;
    vec3 centerNormal = normalize(texelFetch(inNormalVS, fullPix, 0).rgb * 2.0 - 1.0);

    // Linearize depth for stable weights
    float centerZ = linearizeDepth(centerDepth01, scene.cameraClips.x, scene.cameraClips.y);

    // Base half pixel
    ivec2 baseHalfPix = fullPix >> 1;

    ivec2 halfPix00 = clamp(baseHalfPix + ivec2(0, 0), ivec2(0), halfRes - ivec2(1));
    ivec2 halfPix10 = clamp(baseHalfPix + ivec2(1, 0), ivec2(0), halfRes - ivec2(1));
    ivec2 halfPix01 = clamp(baseHalfPix + ivec2(0, 1), ivec2(0), halfRes - ivec2(1));
    ivec2 halfPix11 = clamp(baseHalfPix + ivec2(1, 1), ivec2(0), halfRes - ivec2(1));

    float ao00 = texelFetch(inAOHalf, halfPix00, 0).r;
    float ao10 = texelFetch(inAOHalf, halfPix10, 0).r;
    float ao01 = texelFetch(inAOHalf, halfPix01, 0).r;
    float ao11 = texelFetch(inAOHalf, halfPix11, 0).r;

    // Representative full-res pixels for guide sampling
    ivec2 full00 = clamp(halfPix00 * 2 + ivec2(1, 1), ivec2(0), fullRes - ivec2(1));
    ivec2 full10 = clamp(halfPix10 * 2 + ivec2(1, 1), ivec2(0), fullRes - ivec2(1));
    ivec2 full01 = clamp(halfPix01 * 2 + ivec2(1, 1), ivec2(0), fullRes - ivec2(1));
    ivec2 full11 = clamp(halfPix11 * 2 + ivec2(1, 1), ivec2(0), fullRes - ivec2(1));

    float d00 = linearizeDepth(texelFetch(inCurDepth, full00, 0).r, scene.cameraClips.x, scene.cameraClips.y);
    float d10 = linearizeDepth(texelFetch(inCurDepth, full10, 0).r, scene.cameraClips.x, scene.cameraClips.y);
    float d01 = linearizeDepth(texelFetch(inCurDepth, full01, 0).r, scene.cameraClips.x, scene.cameraClips.y);
    float d11 = linearizeDepth(texelFetch(inCurDepth, full11, 0).r, scene.cameraClips.x, scene.cameraClips.y);

    vec3 n00 = normalize(texelFetch(inNormalVS, full00, 0).rgb * 2.0 - 1.0);
    vec3 n10 = normalize(texelFetch(inNormalVS, full10, 0).rgb * 2.0 - 1.0);
    vec3 n01 = normalize(texelFetch(inNormalVS, full01, 0).rgb * 2.0 - 1.0);
    vec3 n11 = normalize(texelFetch(inNormalVS, full11, 0).rgb * 2.0 - 1.0);

    float w00 = depthWeightLinear(centerZ, d00) * normalWeightExp(centerNormal, n00);
    float w10 = depthWeightLinear(centerZ, d10) * normalWeightExp(centerNormal, n10);
    float w01 = depthWeightLinear(centerZ, d01) * normalWeightExp(centerNormal, n01);
    float w11 = depthWeightLinear(centerZ, d11) * normalWeightExp(centerNormal, n11);

    w00 = max(w00, 1e-4);
    w10 = max(w10, 1e-4);
    w01 = max(w01, 1e-4);
    w11 = max(w11, 1e-4);

    float weightSum = w00 + w10 + w01 + w11;

    float aoOut =
        (ao00 * w00 +
         ao10 * w10 +
         ao01 * w01 +
         ao11 * w11) / weightSum;

    imageStore(outAOFull, fullPix, vec4(aoOut, 0.0, 0.0, 1.0));
}
