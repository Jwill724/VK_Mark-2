#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/rt_shadow_common.glsl"
#include "../include/nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D uDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D uViewNormals;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, r32f) uniform writeonly image2D uPenumbraOut;

shared uint sTileHits;
shared uint sTileTraced;
shared uint sTileDistFx;

const float TILE_DIST_FX     = 256.0;
const float TILE_DIST_CLAMP  = 4096.0;
const int SHADOW_TAPS = 1;

void main()
{
	if (gl_LocalInvocationIndex == 0u)
	{
		sTileHits   = 0u;
		sTileTraced = 0u;
		sTileDistFx = 0u;
	}
	barrier();

	ivec2 px       = ivec2(gl_GlobalInvocationID.xy);
	bool  inBounds = all(lessThan(vec2(px), sp.resolution));

	SceneData sd = getSceneData();

	float depth = inBounds ? texelFetch(uDepth, px, 0).r : 0.0;
	bool  isSky = depth <= DEPTH_EPSILON_REVERSED_Z;

	vec3  L      = normalize(sd.sunlightDirection.xyz);
	vec3  origin = vec3(0.0);
	float viewZ  = 0.0;
	bool  shaded = false;

	// Reconstruct view pos and depth under appropriate conditions
	if (inBounds && !isSky)
	{
		vec3 nVS = octDecode(texelFetch(uViewNormals, px, 0).rg * 2.0 - 1.0);
		vec3 N   = normalize(mat3(sd.invView) * nVS);

		if (dot(N, L) > 0.0)
		{
			vec2 uv = (vec2(px) + 0.5) * sp.invResolution;
			ViewReconstructResult vr = reconstructWorldPosFromDepth(uv, depth, sd.invProj, sd.invView);

			origin = vr.pos + N * rtSurfaceBias(sp.shadow, distance(sd.cameraPos.xyz, vr.pos));
			viewZ  = vr.viewDepth;
			shaded = true;
		}
	}

	float tanRadius = rtSunTanRadius(sp.shadow.sunSoftness);
	vec2  rnd = rtNoise(px, sp.hilbertLutID, sd.temporal.x, RT_NOISE_OFFSET_SHADOW);

	RTVisibility v;
	v.visibility   = 1.0;
	v.occluderDist = 0.0;
	v.hits         = 0.0;

	// Trace all those rays on valid surfaces
	if (shaded)
	{
		v = rtConeVisibilityRnd(origin, L, tanRadius, rnd, SHADOW_TAPS,
			sp.shadow.rayTMin, sp.shadow.rayTMax, sp.shadow.mipBias, sp.shadow.alphaTested != 0u);

		atomicAdd(sTileTraced, 1u);

		// Clean hits
		if (v.hits > 0.0)
		{
			atomicAdd(sTileHits, 1u);
			atomicAdd(sTileDistFx, uint(min(v.occluderDist, TILE_DIST_CLAMP) * TILE_DIST_FX));
		}
	}
	barrier();

	if (!inBounds) return;

	float distanceToOccluder = isSky   ? NRD_FP16_MAX
							 : !shaded ? 0.0
							 : (v.hits > 0.0 ? v.occluderDist : NRD_FP16_MAX);

	imageStore(uPenumbraOut, px, vec4(SIGMA_FrontEnd_PackPenumbra(distanceToOccluder, tanRadius)));
}
