#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/nrd_common.glsl"
#include "../include/rt_shadow_common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D uDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D uViewNormals;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D uVelocity;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D uPrevDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D uShadowPrev;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform usampler2D uShadowInvalid;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, r32f) uniform writeonly image2D uPenumbraOut;

void main()
{
	ivec2 px  = ivec2(gl_GlobalInvocationID.xy);
	ivec2 res = ivec2(sp.resolution);

	bool inBounds = all(lessThan(px, res));

	SceneData sd = getSceneData();
	RTRayListBuffer rays = getRTRayListBuffer();

	float depth = 0.0;
	bool  sky   = true;

	if (inBounds)
	{
		depth = texelFetch(uDepth, px, 0).r;
		sky   = depth <= DEPTH_EPSILON_REVERSED_Z;
	}

	bool  needsRay  = false;
	float staticHit = NRD_FP16_MAX;

	if (inBounds && !sky)
	{
		vec3 nVS = octDecode(texelFetch(uViewNormals, px, 0).rg * 2.0 - 1.0);

		if (dot(nVS, vec3(sp.shadow.sunDirectionVS)) <= 0.0) staticHit = 0.0;
		else                                                 needsRay  = true;
	}

	if (needsRay && sd.temporal.y != 0u && texelFetch(uShadowInvalid, px >> 3, 0).r == 0u)
	{
		vec2 uv     = (vec2(px) + 0.5) * sp.invResolution;
		vec2 prevUv = uv - texelFetch(uVelocity, px, 0).rg;

		if (all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0))))
		{
			ivec2 ppx = clamp(ivec2(prevUv * sp.resolution), ivec2(0), res - 1);

			float viewZ = screenToViewDepth(
				depth, sd.depthLinearizeMult, sd.depthLinearizeAdd);

			float prevViewZ = screenToViewDepth(
				texelFetch(uPrevDepth, ppx, 0).r,
				sd.depthLinearizeMult, sd.depthLinearizeAdd);

			if (abs(prevViewZ - viewZ) < viewZ * sp.disocclusionScale)
			{
				vec4 s = textureGather(uShadowPrev, prevUv, 0);

				float sMin = min(min(s.x, s.y), min(s.z, s.w));
				float sMax = max(max(s.x, s.y), max(s.z, s.w));

				bool lit      = sMin >= 1.0 - sp.saturationEps;
				bool shadowed = sMax <= sp.saturationEps;

				uint phase = (uint(px.x) * 3u + uint(px.y) * 5u + sd.temporal.x) & 3u;

				if ((lit || shadowed) && phase != 0u)
				{
					staticHit = lit ? NRD_FP16_MAX : 0.0;
					needsRay  = false;
				}
			}
		}
	}

	uint slot = rtCompactAppend(
		rays, RT_RAY_SLOT_SHADOW, sp.rayBase, sp.rayCapacity, needsRay);

	if (!inBounds) return;

	if (needsRay && slot != RT_INVALID_SLOT)
	{
		rays.payload[slot] = rtPackPixel(uvec2(px));
		return;
	}

	imageStore(
		uPenumbraOut,
		px,
		vec4(SIGMA_FrontEnd_PackPenumbra(staticHit, TAN_SUN_ANGULAR_RADIUS)));
}