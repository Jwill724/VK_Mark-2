#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/reflect_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D uDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D uAlbedoRough;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, r16f)    uniform writeonly image2D uRoughness;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2, rgba16f) uniform writeonly image2D uRadiance;

void main()
{
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	bool inBounds = all(lessThan(px, ivec2(rp.halfResSize)));

	float depth     = 0.0;
	float roughness = 1.0;

	if (inBounds)
	{
		vec2 uv = (vec2(px) + 0.5) * rp.halfResTexel;

		depth = textureLod(uDepth, uv, 0.0).r;

		float stored = textureLod(uAlbedoRough, uv, 0.0).a;
		roughness = stored * stored;

		imageStore(uRoughness, px, vec4(roughness));
	}

	bool reflective = inBounds && depth > 0.0 && roughness < rp.reflectRoughnessCutoff;

	if (inBounds && !reflective)
		imageStore(uRadiance, px, vec4(0.0));

	RTRayListBuffer rays = getRTRayListBuffer();

	uint slot = rtCompactAppend(rays, RT_RAY_SLOT_REFLECT, rp.rayCapacity, reflective);

	if (reflective)
	{
		if (slot != RT_INVALID_SLOT)
			rays.payload[slot] = rtPackPixel(uvec2(px));
		else
			imageStore(uRadiance, px, vec4(0.0));
	}
}
