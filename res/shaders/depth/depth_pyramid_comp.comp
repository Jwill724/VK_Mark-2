#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/gpu_scene_structures.glsl"
#include "../include/set_bindings.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Input depth (mip0 or previous mip)
layout(set = PUSH_SET, binding = PUSH_BINDING_DEPTH_TEX) uniform sampler2D inDepth;

// current pyramid mip, r16
layout(set = PUSH_SET, binding = PUSH_BINDING_OUTPUT_1_TEX) writeonly uniform image2D outMip;

layout(set = FRAME_SET, binding = FRAME_BINDING_SCENE) uniform SceneUBO {
	SceneData scene;
};

layout(push_constant) uniform DepthPyramidPush {
	uint mipLevel;
	float pad0;
	vec2 invSize; // 1.0 / current mip res
} pc;

void main()
{
	ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);

	// Reconstruct source and destination sizes from invSize
	float srcWidthF = 1.0 / pc.invSize.x;
	float srcHeightF = 1.0 / pc.invSize.y;

	int srcWidth = int(srcWidthF + 0.5);
	int srcHeight = int(srcHeightF + 0.5);

	int dstWidth;
	int dstHeight;

	if (pc.mipLevel == 0u) {
		dstWidth = srcWidth;
		dstHeight = srcHeight;
	} else {
		dstWidth = max(1, srcWidth / 2);
		dstHeight = max(1, srcHeight / 2);
	}

	// Bounds check on destination
	if (dstCoord.x >= dstWidth || dstCoord.y >= dstHeight) return;

	if (pc.mipLevel == 0u) {
		// Mip 0: rawDepth to linear
		float rawDepth = texelFetch(inDepth, dstCoord, 0).r;

		float linearDepth = linearizeDepth(
			rawDepth,
			scene.cameraClips.x,
			scene.cameraClips.y
		);

		imageStore(outMip, dstCoord, vec4(linearDepth, 0.0, 0.0, 0.0));
	}
	else {
		// Mip N: Downsample from mip N - 1
		ivec2 srcCoordBase = dstCoord * 2;

		ivec2 maxSrcCoord = ivec2(srcWidth - 1, srcHeight - 1);

		ivec2 c00 = clamp(srcCoordBase, ivec2(0), maxSrcCoord);
		ivec2 c10 = clamp(srcCoordBase + ivec2(1, 0), ivec2(0), maxSrcCoord);
		ivec2 c01 = clamp(srcCoordBase + ivec2(0, 1), ivec2(0), maxSrcCoord);
		ivec2 c11 = clamp(srcCoordBase + ivec2(1, 1), ivec2(0), maxSrcCoord);

		float d00 = texelFetch(inDepth, c00, 0).r;
		float d10 = texelFetch(inDepth, c10, 0).r;
		float d01 = texelFetch(inDepth, c01, 0).r;
		float d11 = texelFetch(inDepth, c11, 0).r;

		float minDepth = min(min(d00, d10), min(d01, d11));

		imageStore(outMip, dstCoord, vec4(minDepth, 0.0, 0.0, 0.0));
	}
}